# Primair productiedomein voor canonicals, sitemap.xml en JSON-LD
# Voorbeelden: https://quintendesmyter.be of https://7ol.eu
PUBLIC_SITE_URL=https://quintendesmyter.be

# Statisch contactformulier zonder eigen backend (kies Web3Forms OF Formspree)
# Optie 1 (Web3Forms): vul je access key in (endpoint wordt automatisch ingesteld)
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Optie 2 (Formspree of eigen extern endpoint): bv. https://formspree.io/f/jouw-id
PUBLIC_CONTACT_ENDPOINT=

# Optionele Cloudflare Turnstile site key voor extra anti-spam bescherming
PUBLIC_TURNSTILE_SITE_KEY=

# Optionele directe MP4- of Bunny CDN-URL voor de videoshowreel op /fotografie
PUBLIC_SHOWREEL_URL=
