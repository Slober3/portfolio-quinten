# Apache / LiteSpeed configuratie voor statische hosting (Quinten Desmyter Portfolio)
Options -Indexes +FollowSymLinks
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS (werkt domein-agnostisch op eender welk domein)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. Slimme root-redirect (/) op basis van Accept-Language -> /en/ of fallback /nl/
  RewriteCond %{REQUEST_URI} ^/$
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [R=302,L]

  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ /nl/ [R=302,L]

  # 3. Schone URL's voor statische submappen en .html fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# 4. Aangepaste tweetalige 404-routes
ErrorDocument 404 /nl/404/index.html
<If "%{REQUEST_URI} =~ m#^/en/#">
  ErrorDocument 404 /en/404/index.html
</If>

# 5. Lange immutable cache voor gehashte Astro-bundels en lokale fonts
<IfModule mod_headers.c>
  Header always append Vary Accept-Language env=REDIRECT_STATUS

  <FilesMatch "\.(woff2|avif|webp|css|js|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # 6. Strikte Security Headers (compatibel met Astro inline scripts, MapLibre, YouTube-nocookie & Web3Forms/Formspree)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://i.ytimg.com; media-src 'self' https://*.b-cdn.net https://iframe.mediadelivery.net; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com https://iframe.mediadelivery.net; connect-src 'self' https://api.web3forms.com https://formspree.io; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com https://formspree.io; upgrade-insecure-requests;"
</IfModule>
