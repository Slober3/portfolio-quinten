---
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';

const powerUps = [
  {
    name: 'The Void',
    effect: isNl
      ? 'Neutraliseert een gevaarlijke claim of voorkomt Soul-verlies op het beslissende moment.'
      : 'Neutralizes a threatening claim or prevents Soul loss at the decisive reveal.',
  },
  {
    name: 'The Prison',
    effect: isNl
      ? 'Zet een medespeler of diens dobbelbeker tijdelijk vast om een aanvalsketen te breken.'
      : 'Temporarily locks a rival player’s cup to disrupt aggressive bidding chains.',
  },
  {
    name: 'Freeze',
    effect: isNl
      ? 'Bevriest de actieve dobbelstatus zodat een tegenstander niet zomaar kan herwerpen.'
      : 'Freezes active dice state before a rival can reset unfavorable odds.',
  },
  {
    name: 'Second Chance',
    effect: isNl
      ? 'Laatste vangnet wanneer je op het punt staat kostbare Souls uit je 16-Soul pool te verliezen.'
      : 'Crucial safety net triggered right before losing precious Souls from your 16-Soul pool.',
  },
  {
    name: 'Re-roll',
    effect: isNl
      ? 'Herschept jouw eigen hand vóór je een nieuwe bluf of verhoging uitspreekt.'
      : 'Refreshes your own dice roll before committing to a higher bid.',
  },
  {
    name: 'Powerless',
    effect: isNl
      ? 'Schakelt de Power-Up invloed van een tegenstander voor één beurt volledig uit.'
      : 'Cancels a rival player’s card interference for a single tense turn.',
  },
];
---

<section
  class="editorial-card rounded-2xl p-6 sm:p-8 space-y-6"
  aria-labelledby="weavers-widget-heading"
>
  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-border-subtle pb-4">
    <div>
      <p class="font-mono text-xs uppercase tracking-wider text-kinetic">
        {isNl ? 'INTERACTIEVE MODULE · KANSREKENING & POWER-UPS' : 'INTERACTIVE WIDGET · PROBABILITY & POWER-UPS'}
      </p>
      <h3 id="weavers-widget-heading" class="mt-1 font-display text-xl sm:text-2xl font-bold text-ink-primary">
        {isNl ? 'Weavers Fate — Tafelkansen & 16 Souls Simulator' : 'Weavers Fate — Table Odds & 16 Souls Explorer'}
      </h3>
    </div>
    <span class="font-mono text-xs text-ink-secondary">28 D6 · Cup of Fate · Chaos Counter</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Left: Binomial Probability Estimator -->
    <div class="rounded-xl border border-border-subtle bg-surface-2/60 p-5 space-y-4">
      <p class="font-mono text-xs uppercase tracking-wider text-telemetry">
        {isNl ? 'Binomiale Biedkans Estimator' : 'Binomial Bid Probability Estimator'}
      </p>

      <div class="space-y-3">
        <div>
          <label for="wf-total-dice" class="flex justify-between text-xs font-mono text-ink-secondary mb-1">
            <span>{isNl ? 'Dobbelstenen nog in het spel (inclusief Cup of Fate)' : 'Dice remaining in play (incl. Cup of Fate)'}</span>
            <strong id="wf-total-dice-val" class="text-ink-primary">24</strong>
          </label>
          <input
            id="wf-total-dice"
            type="range"
            min="4"
            max="28"
            value="24"
            class="w-full accent-[var(--accent-kinetic)] cursor-pointer"
          />
        </div>

        <div>
          <label for="wf-target-count" class="flex justify-between text-xs font-mono text-ink-secondary mb-1">
            <span>{isNl ? 'Uitgesproken aantal van jouw doelcijfer (k)' : 'Claimed minimum count of target face (k)'}</span>
            <strong id="wf-target-count-val" class="text-ink-primary">5</strong>
          </label>
          <input
            id="wf-target-count"
            type="range"
            min="1"
            max="16"
            value="5"
            class="w-full accent-[var(--accent-telemetry)] cursor-pointer"
          />
        </div>

        <label class="flex items-center gap-2.5 text-sm text-ink-primary cursor-pointer pt-1">
          <input id="wf-wild-ones" type="checkbox" checked class="h-4 w-4 accent-[var(--accent-status)]" />
          <span>
            {isNl
              ? 'Tel 1-ogen mee als joker (p = 1/3 per D6 i.p.v. 1/6)'
              : 'Include 1s as wilds (p = 1/3 per D6 instead of 1/6)'}
          </span>
        </label>
      </div>

      <div class="rounded-xl border border-border-subtle bg-surface-1 p-4 flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="font-mono text-[11px] uppercase text-ink-secondary">
            {isNl ? 'Kans op minstens k treffers' : 'Probability of at least k matches'}
          </p>
          <p id="wf-prob-output" class="font-display text-3xl font-bold text-kinetic mt-0.5" aria-live="polite">
            91.8%
          </p>
        </div>
        <div class="text-right font-mono text-xs text-ink-secondary">
          <p>{isNl ? 'Verwachte waarde (E[X]):' : 'Expected count (E[X]):'}</p>
          <p id="wf-expected-output" class="text-ink-primary font-semibold text-sm mt-0.5">8.0 D6</p>
        </div>
      </div>
    </div>

    <!-- Right: 6 Power-Ups Explorer -->
    <div class="rounded-xl border border-border-subtle bg-surface-2/60 p-5 space-y-4 flex flex-col justify-between">
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-kinetic mb-3">
          {isNl ? 'Power-Up Kaarten (Klik om effect te bekijken)' : 'Power-Up Cards (Select to inspect effect)'}
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" role="tablist" aria-label="Power-Up cards">
          {powerUps.map((card, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-wf-card={idx}
              data-wf-name={card.name}
              data-wf-effect={card.effect}
              class:list={[
                'wf-card-btn rounded-xl border px-3 py-2 text-left font-mono text-xs font-semibold transition-colors cursor-pointer min-h-[44px]',
                idx === 0
                  ? 'bg-kinetic text-canvas border-kinetic'
                  : 'bg-surface-1 text-ink-secondary border-border-subtle hover:text-ink-primary',
              ]}
            >
              {card.name}
            </button>
          ))}
        </div>
      </div>

      <div class="rounded-xl border border-border-subtle bg-surface-1 p-4">
        <p id="wf-card-title" class="font-display text-base font-bold text-ink-primary">{powerUps[0].name}</p>
        <p id="wf-card-desc" class="mt-1.5 text-sm text-ink-secondary" aria-live="polite">{powerUps[0].effect}</p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const diceInput = document.getElementById('wf-total-dice');
    const targetInput = document.getElementById('wf-target-count');
    const wildInput = document.getElementById('wf-wild-ones');
    const diceVal = document.getElementById('wf-total-dice-val');
    const targetVal = document.getElementById('wf-target-count-val');
    const probOut = document.getElementById('wf-prob-output');
    const expOut = document.getElementById('wf-expected-output');

    if (!diceInput || !targetInput || !wildInput || !probOut || !expOut) return;

    function comb(n, k) {
      if (k < 0 || k > n) return 0;
      if (k === 0 || k === n) return 1;
      const m = Math.min(k, n - k);
      let res = 1;
      for (let i = 1; i <= m; i += 1) {
        res = (res * (n - m + i)) / i;
      }
      return res;
    }

    function updateOdds() {
      const n = Number(diceInput.value);
      const maxK = Math.min(16, n);
      targetInput.max = String(maxK);
      let k = Number(targetInput.value);
      if (k > n) {
        k = n;
        targetInput.value = String(k);
      }
      const p = wildInput.checked ? 1 / 3 : 1 / 6;
      let probAtLeastK = 0;
      for (let i = k; i <= n; i += 1) {
        probAtLeastK += comb(n, i) * (p ** i) * ((1 - p) ** (n - i));
      }
      if (diceVal) diceVal.textContent = String(n);
      if (targetVal) targetVal.textContent = String(k);
      probOut.textContent = `${Math.min(100, Math.max(0, probAtLeastK * 100)).toFixed(1)}%`;
      expOut.textContent = `${(n * p).toFixed(1)} D6`;
    }

    diceInput.addEventListener('input', updateOdds);
    targetInput.addEventListener('input', updateOdds);
    wildInput.addEventListener('change', updateOdds);
    updateOdds();

    const cardBtns = document.querySelectorAll('[data-wf-card]');
    const cardTitle = document.getElementById('wf-card-title');
    const cardDesc = document.getElementById('wf-card-desc');

    cardBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-wf-name') || '';
        const effect = btn.getAttribute('data-wf-effect') || '';
        if (cardTitle) cardTitle.textContent = name;
        if (cardDesc) cardDesc.textContent = effect;

        cardBtns.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-selected', String(active));
          b.className = active
            ? 'wf-card-btn rounded-xl border px-3 py-2 text-left font-mono text-xs font-semibold transition-colors cursor-pointer min-h-[44px] bg-kinetic text-canvas border-kinetic'
            : 'wf-card-btn rounded-xl border px-3 py-2 text-left font-mono text-xs font-semibold transition-colors cursor-pointer min-h-[44px] bg-surface-1 text-ink-secondary border-border-subtle hover:text-ink-primary';
        });
      });
    });
  })();
</script>
