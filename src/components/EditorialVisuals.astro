---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '@/i18n/routes';

import quintenPortrait from '@/assets/photos/quinten-portrait.jpg';
import hornetAction from '@/assets/photos/hornet-action.jpg';
import hornetCobblestones from '@/assets/photos/hornet-cobblestones.jpg';
import motoGoldenHour from '@/assets/photos/moto-golden-hour.jpg';
import stitchPortrait from '@/assets/photos/stitch-portrait.jpg';
import stitchDuo from '@/assets/photos/stitch-duo.jpg';
import macroHoverfly from '@/assets/photos/macro-hoverfly.jpg';
import macroMushroomFly from '@/assets/photos/macro-mushroom-fly.jpg';
import macroWoodland from '@/assets/photos/macro-woodland-cluster.jpg';
import travelDubrovnik from '@/assets/photos/travel-dubrovnik.jpg';
import travelLondon from '@/assets/photos/travel-london.jpg';
import travelAachen from '@/assets/photos/travel-aachen.jpg';
import makerPcb from '@/assets/photos/maker-pcb.jpg';
import makerGearmotor from '@/assets/photos/maker-gearmotor.jpg';

type EditorialPhotoKind =
  | 'portrait'
  | 'cloud'
  | 'hornet'
  | 'hornetSquare'
  | 'motoSunset'
  | 'stitch'
  | 'stitchDuo'
  | 'macro'
  | 'macroMushroom'
  | 'macroCluster'
  | 'travel'
  | 'london'
  | 'aachen'
  | 'pcb'
  | 'iot'
  | 'gearmotor'
  | 'weavers'
  | 'cvTarget';

interface Props {
  kind: EditorialPhotoKind;
  locale?: Locale;
  alt?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  kind,
  locale = 'nl',
  alt,
  eager = false,
  sizes = '(max-width: 768px) 96vw, (max-width: 1200px) 50vw, 720px',
  class: extraClass = '',
} = Astro.props;

const mediaMap: Record<EditorialPhotoKind, { src: ImageMetadata; alt: { nl: string; en: string }; pos?: string }> = {
  portrait: {
    src: quintenPortrait,
    pos: 'object-[50%_28%]',
    alt: {
      nl: 'Portret van Quinten Desmyter op de Millennium Bridge in Londen met St Paul’s Cathedral op de achtergrond',
      en: 'Portrait of Quinten Desmyter on Millennium Bridge in London with St Paul’s Cathedral behind him',
    },
  },
  cloud: {
    src: makerPcb,
    alt: {
      nl: 'Zelf ontworpen matzwarte ESP32- en motordriver-printplaat van Quinten',
      en: 'Custom matte-black ESP32 and motor-driver PCB designed by Quinten',
    },
  },
  hornet: {
    src: hornetAction,
    pos: 'object-[50%_45%]',
    alt: {
      nl: 'Quinten in beweging op zijn gele Honda CB750 Hornet',
      en: 'Quinten riding his yellow Honda CB750 Hornet in motion',
    },
  },
  hornetSquare: {
    src: hornetCobblestones,
    alt: {
      nl: 'Gele Honda CB750 Hornet naast een klassieke rode Honda op een kasseiplein bij avondlicht',
      en: 'Yellow Honda CB750 Hornet parked beside a classic red Honda on cobblestones at blue hour',
    },
  },
  motoSunset: {
    src: motoGoldenHour,
    alt: {
      nl: 'Avondstop langs de weg in motorkledij bij laag zonlicht',
      en: 'Golden-hour roadside stop in riding gear beside the motorcycles',
    },
  },
  stitch: {
    src: stitchPortrait,
    pos: 'object-[50%_35%]',
    alt: {
      nl: 'Close-up portret van teckel Stitch',
      en: 'Close-up portrait of dachshund Stitch',
    },
  },
  stitchDuo: {
    src: stitchDuo,
    pos: 'object-[50%_35%]',
    alt: {
      nl: 'Teckel Stitch samen op de foto met een tweede teckel',
      en: 'Dachshund Stitch photographed alongside his companion dachshund',
    },
  },
  macro: {
    src: macroHoverfly,
    alt: {
      nl: 'Macrofoto van een zweefvlieg recht van voren op een blauwe reling',
      en: 'Head-on macro photograph of a hoverfly perched on a blue railing',
    },
  },
  macroMushroom: {
    src: macroMushroomFly,
    alt: {
      nl: 'Macrofoto van een vlieg op een bospaddenstoel tussen herfstbladeren',
      en: 'Macro photograph of a fly resting on a woodland mushroom amid autumn leaves',
    },
  },
  macroCluster: {
    src: macroWoodland,
    alt: {
      nl: 'Tros wilde zwammen op een bemoste boomstam in het bos',
      en: 'Wild cluster of woodland mushrooms growing on mossy tree bark',
    },
  },
  travel: {
    src: travelDubrovnik,
    alt: {
      nl: 'Verlichte stadsmuren van Dubrovnik weerspiegeld in het water bij nacht',
      en: 'Illuminated stone walls of Dubrovnik reflecting in the calm harbor at night',
    },
  },
  london: {
    src: travelLondon,
    alt: {
      nl: 'Old Billingsgate Market langs de Theems in Londen tijdens het blauwe uur',
      en: 'Old Billingsgate Market along the Thames in London at blue hour',
    },
  },
  aachen: {
    src: travelAachen,
    alt: {
      nl: 'Gotische stenen gevel en toren van het stadhuis van Aken',
      en: 'Gothic stone facade and tower of Aachen City Hall',
    },
  },
  pcb: {
    src: makerPcb,
    alt: {
      nl: 'Eigen ontworpen matzwarte ESP32- en L298N-printplaat in de verpakking',
      en: 'Custom matte-black ESP32 and L298N circuit board straight from fabrication',
    },
  },
  iot: {
    src: makerPcb,
    alt: {
      nl: 'Eigen ontworpen ESP32-printplaat voor embedded- en IoT-experimenten',
      en: 'Custom-designed ESP32 circuit board for embedded and IoT experiments',
    },
  },
  gearmotor: {
    src: makerGearmotor,
    alt: {
      nl: 'Tandwieloverbrenging en DC-motor op de elektronicawerkbank',
      en: 'Geared DC motor assembly on the electronics workbench',
    },
  },
  weavers: {
    src: travelAachen,
    alt: {
      nl: 'Sfeervolle gotische architectuur in Aken als inspiratie voor spelwerelden en ontwerp',
      en: 'Atmospheric Gothic architecture in Aachen inspiring tabletop worlds and design',
    },
  },
  cvTarget: {
    src: makerGearmotor,
    alt: {
      nl: 'Precisie-mechaniek en meetopstelling op de werkbank',
      en: 'Precision mechanics and measurement hardware on the workbench',
    },
  },
};

const item = mediaMap[kind];
const resolvedAlt = alt ?? item.alt[locale];
const objectPos = item.pos ?? 'object-center';
---

<Picture
  src={item.src}
  alt={resolvedAlt}
  formats={['avif', 'webp']}
  widths={[480, 960, 1440]}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  class={`w-full h-full object-cover block ${objectPos} ${extraClass}`}
/>
