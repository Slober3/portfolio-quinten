---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '@/i18n/routes';

import heroWorkspace from '@/assets/photos/hero-workspace.jpg';
import hornetApex from '@/assets/photos/hornet-apex-dusk.jpg';
import spaCurves from '@/assets/photos/spa-raidillon-mist.jpg';
import weaversFate from '@/assets/photos/project-weavers-fate.jpg';
import macroDew from '@/assets/photos/macro-dew-optics.jpg';
import precisionSport from '@/assets/photos/project-precision-sport.jpg';
import pcbBench from '@/assets/photos/pcb-bench-craft.jpg';
import stitchCozy from '@/assets/photos/about-stitch-cozy.jpg';
import lasercutKalimba from '@/assets/photos/lasercut-kalimba-lab.jpg';
import dubrovnikStone from '@/assets/photos/adriatic-stone-dubrovnik.jpg';
import portugalCliffs from '@/assets/photos/atlantic-cliffs-portugal.jpg';

type EditorialPhotoKind = 'cloud' | 'hornet' | 'spa' | 'weavers' | 'macro' | 'cvTarget' | 'iot' | 'pcb' | 'stitch' | 'craft' | 'travel' | 'coast';

interface Props {
  kind: EditorialPhotoKind;
  locale?: Locale;
  alt?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  kind,
  locale = 'nl',
  alt,
  eager = false,
  sizes = '(max-width: 768px) 96vw, (max-width: 1200px) 50vw, 720px',
  class: extraClass = '',
} = Astro.props;

const mediaMap: Record<EditorialPhotoKind, { src: ImageMetadata; alt: { nl: string; en: string } }> = {
  cloud: {
    src: heroWorkspace,
    alt: {
      nl: 'Werkplek met ultrawide-scherm, microfoon op boom arm en warm bureaulicht',
      en: 'Desk workspace with ultrawide monitor, boom-arm studio microphone, and warm lamp light',
    },
  },
  hornet: {
    src: hornetApex,
    alt: {
      nl: 'Matzwarte naked bike langs een bochtige bergweg bij zonsondergang',
      en: 'Matte-black naked motorcycle parked beside a winding mountain road at golden hour',
    },
  },
  spa: {
    src: spaCurves,
    alt: {
      nl: 'Bochtige weg door mistige Ardense dennenbossen in de vroege ochtendzon',
      en: 'Sweeping tarmac winding through misty Ardennes pine hills in early morning sun',
    },
  },
  weavers: {
    src: weaversFate,
    alt: {
      nl: 'Leren dobbelbekers, doorzichtige amberkleurige en donkere dobbelstenen en kaarten van Weavers Fate op leisteen',
      en: 'Leather dice cups, amber and obsidian dice, and tabletop cards for Weavers Fate on slate',
    },
  },
  macro: {
    src: macroDew,
    alt: {
      nl: 'Macrofoto van een wilde bospaddenstoel op vochtig mos met fijne regendruppels',
      en: 'Macro photograph of a wild woodland mushroom on damp forest moss with fine dew drops',
    },
  },
  cvTarget: {
    src: precisionSport,
    alt: {
      nl: 'Papieren schietschijf, optische spotting scope en leren trainingsnotitieboek op een houten tafel',
      en: 'Concentric paper precision target, optical spotting scope, and leather training notebook on wood',
    },
  },
  iot: {
    src: pcbBench,
    alt: {
      nl: 'Eigen ontworpen matzwarte en goudkleurige printplaat op een elektronicawerkbank',
      en: 'Custom matte-black and gold PCB circuit board on an electronics workbench',
    },
  },
  pcb: {
    src: pcbBench,
    alt: {
      nl: 'Close-up van een zelf ontworpen printplaat met microcontroller en precisiepincet',
      en: 'Close-up of a custom-designed circuit board with microcontroller and precision tweezers',
    },
  },
  stitch: {
    src: stitchCozy,
    alt: {
      nl: 'Teckel Stitch ontspannen op een kleed naast een boekenkast met warm avondlicht',
      en: 'Dachshund Stitch resting peacefully on a rug beside a bookshelf in warm evening light',
    },
  },
  craft: {
    src: lasercutKalimba,
    alt: {
      nl: 'Houten 17-toets kalimba naast gelaserde houten spelfiches en een 3D-geprinte miniatuurboog',
      en: 'Wooden 17-key kalimba beside laser-cut wooden game tokens and a 3D-printed miniature archway',
    },
  },
  travel: {
    src: dubrovnikStone,
    alt: {
      nl: 'Oude stadsmuren en rode daken van Dubrovnik in warm avondlicht aan de Adriatische Zee',
      en: 'Historic stone ramparts and terracotta roofs of Dubrovnik in warm late-afternoon light',
    },
  },
  coast: {
    src: portugalCliffs,
    alt: {
      nl: 'Zandstenen kliffen aan de Atlantische kust in Portugal bij zonsondergang',
      en: 'Golden sandstone sea cliffs along the Portuguese Atlantic coast at sunset',
    },
  },
};

const item = mediaMap[kind];
const resolvedAlt = alt ?? item.alt[locale];
---

<Picture
  src={item.src}
  alt={resolvedAlt}
  formats={['avif', 'webp']}
  widths={[480, 960, 1440]}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  class={`w-full h-full object-cover block ${extraClass}`}
/>
