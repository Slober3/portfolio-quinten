---
interface Props {
  kind: 'cloud' | 'hornet' | 'weavers' | 'macro' | 'cvTarget' | 'iot' | 'pcb';
}

const { kind } = Astro.props;
---

{kind === 'cloud' && (
  <svg
    viewBox="0 0 640 240"
    class="w-full h-full block"
    role="img"
    aria-label="Schematische visualisatie van Cloud, Cisco CCNA en Systems as Code labarchitectuur"
  >
    <rect width="640" height="240" rx="14" fill="var(--bg-surface-2)" />
    <g stroke="var(--border-subtle)" stroke-width="1" stroke-dasharray="4 6">
      <line x1="0" y1="80" x2="640" y2="80" />
      <line x1="0" y1="160" x2="640" y2="160" />
      <line x1="213" y1="0" x2="213" y2="240" />
      <line x1="426" y1="0" x2="426" y2="240" />
    </g>
    <g stroke="var(--accent-telemetry)" stroke-width="2" opacity="0.85">
      <line x1="150" y1="120" x2="320" y2="66" />
      <line x1="150" y1="120" x2="320" y2="174" />
      <line x1="320" y1="66" x2="490" y2="120" />
      <line x1="320" y1="174" x2="490" y2="120" />
    </g>
    <g font-family="var(--font-mono)">
      <rect x="64" y="92" width="144" height="56" rx="10" fill="var(--bg-surface-1)" stroke="var(--accent-telemetry)" stroke-width="1.5" />
      <text x="136" y="116" text-anchor="middle" fill="var(--text-primary)" font-size="12" font-weight="600">AWS & Docker</text>
      <text x="136" y="135" text-anchor="middle" fill="var(--accent-telemetry)" font-size="10">1ITF / 1ACS LABS</text>

      <rect x="248" y="38" width="144" height="56" rx="10" fill="var(--bg-surface-1)" stroke="var(--accent-status)" stroke-width="1.5" />
      <text x="320" y="62" text-anchor="middle" fill="var(--text-primary)" font-size="12" font-weight="600">Cisco CCNA 1–2</text>
      <text x="320" y="81" text-anchor="middle" fill="var(--accent-status)" font-size="10">RTC / ROUTING</text>

      <rect x="248" y="146" width="144" height="56" rx="10" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" stroke-width="1.5" />
      <text x="320" y="170" text-anchor="middle" fill="var(--text-primary)" font-size="12" font-weight="600">PowerShell + Pester</text>
      <text x="320" y="189" text-anchor="middle" fill="var(--text-secondary)" font-size="10">SYSTEMS AS CODE</text>

      <rect x="432" y="92" width="144" height="56" rx="10" fill="var(--bg-surface-1)" stroke="var(--accent-kinetic)" stroke-width="1.5" />
      <text x="504" y="116" text-anchor="middle" fill="var(--text-primary)" font-size="12" font-weight="600">2× ISBN Books</text>
      <text x="504" y="135" text-anchor="middle" fill="var(--accent-kinetic)" font-size="10">SECURITY & PYTHON</text>
    </g>
  </svg>
)}

{kind === 'hornet' && (
  <svg
    viewBox="0 0 720 280"
    class="w-full h-full block"
    role="img"
    aria-label="MotoAdventures routetelemetrie voor Honda CB750 Hornet met hoogtelijn en 5 km privacy-trim"
  >
    <defs>
      <linearGradient id="hornetGrad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--accent-kinetic)" stop-opacity="0.2" />
        <stop offset="100%" stop-color="var(--accent-telemetry)" stop-opacity="0.06" />
      </linearGradient>
    </defs>
    <rect width="720" height="280" rx="14" fill="var(--bg-surface-2)" />
    <rect width="720" height="280" rx="14" fill="url(#hornetGrad)" />
    <g stroke="var(--border-subtle)" stroke-width="1" opacity="0.65">
      <line x1="40" y1="64" x2="680" y2="64" />
      <line x1="40" y1="126" x2="680" y2="126" />
      <line x1="40" y1="188" x2="680" y2="188" />
    </g>
    <path
      d="M 52 214 C 122 214, 144 120, 210 138 C 282 156, 294 74, 376 88 C 454 102, 444 176, 514 152 C 578 130, 594 74, 668 96"
      fill="none"
      stroke="var(--accent-kinetic)"
      stroke-width="4.5"
      stroke-linecap="round"
    />
    <line x1="106" y1="48" x2="106" y2="232" stroke="var(--accent-status)" stroke-width="1.5" stroke-dasharray="4 4" />
    <line x1="614" y1="48" x2="614" y2="232" stroke="var(--accent-status)" stroke-width="1.5" stroke-dasharray="4 4" />
    <circle cx="106" cy="182" r="5" fill="var(--accent-status)" />
    <circle cx="376" cy="88" r="6" fill="var(--accent-kinetic)" />
    <circle cx="614" cy="94" r="5" fill="var(--accent-status)" />

    <rect x="32" y="20" width="240" height="30" rx="7" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" />
    <text x="46" y="39" fill="var(--accent-kinetic)" font-size="11.5" font-family="var(--font-mono)" font-weight="600">CB750 HORNET · ~35.000 KM</text>

    <rect x="470" y="20" width="218" height="30" rx="7" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" />
    <text x="579" y="39" text-anchor="middle" fill="var(--accent-status)" font-size="11.5" font-family="var(--font-mono)">GPX OPSEC: ±5 KM TRIM ✓</text>

    <rect x="32" y="232" width="656" height="30" rx="7" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" />
    <text x="48" y="251" fill="var(--text-secondary)" font-size="11.5" font-family="var(--font-mono)">
      KURVIGER / CALIMOTO · DJI OSMO ACTION + ND · DJI MIC MINI · SPA 2025 (6 TESTRIDES)
    </text>
  </svg>
)}

{kind === 'weavers' && (
  <svg
    viewBox="0 0 480 210"
    class="w-full h-full block"
    role="img"
    aria-label="Visualisatie van Weavers Fate spelmechaniek: Cup of Fate, 28 D6 en 16 Souls"
  >
    <rect width="480" height="210" rx="12" fill="var(--bg-surface-2)" />
    <circle cx="128" cy="105" r="64" fill="var(--bg-surface-1)" stroke="var(--accent-kinetic)" stroke-width="2" />
    <circle cx="128" cy="105" r="46" fill="none" stroke="var(--accent-telemetry)" stroke-width="1.5" stroke-dasharray="5 4" />
    <text x="128" y="100" text-anchor="middle" fill="var(--accent-kinetic)" font-size="22" font-family="var(--font-display)" font-weight="700">16</text>
    <text x="128" y="120" text-anchor="middle" fill="var(--text-secondary)" font-size="10.5" font-family="var(--font-mono)">SOULS</text>

    <g font-family="var(--font-mono)" font-size="11.5">
      <rect x="232" y="32" width="214" height="38" rx="8" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" />
      <text x="248" y="55" fill="var(--text-primary)">CUP OF FATE · 28 × D6</text>

      <rect x="232" y="86" width="214" height="38" rx="8" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" />
      <text x="248" y="109" fill="var(--accent-kinetic)">CHAOS COUNTER · +1 / TURN</text>

      <rect x="232" y="140" width="214" height="38" rx="8" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" />
      <text x="248" y="163" fill="var(--accent-telemetry)">6 POWER-UP CARDS</text>
    </g>
  </svg>
)}

{kind === 'macro' && (
  <svg
    viewBox="0 0 640 240"
    class="w-full h-full block"
    role="img"
    aria-label="Zoekercompositie van fotografiecollectie met EXIF-privacyvalidatie"
  >
    <defs>
      <radialGradient id="macroLensGlow" cx="50%" cy="50%" r="55%">
        <stop offset="0%" stop-color="var(--accent-telemetry)" stop-opacity="0.24" />
        <stop offset="65%" stop-color="var(--accent-kinetic)" stop-opacity="0.1" />
        <stop offset="100%" stop-color="var(--bg-surface-2)" stop-opacity="1" />
      </radialGradient>
    </defs>
    <rect width="640" height="240" rx="14" fill="var(--bg-surface-2)" />
    <rect width="640" height="240" rx="14" fill="url(#macroLensGlow)" />
    <g stroke="var(--border-subtle)" stroke-width="1" opacity="0.7">
      <line x1="213" y1="16" x2="213" y2="224" />
      <line x1="426" y1="16" x2="426" y2="224" />
      <line x1="20" y1="80" x2="620" y2="80" />
      <line x1="20" y1="160" x2="620" y2="160" />
    </g>
    <path d="M 278 90 L 278 74 L 294 74 M 362 90 L 362 74 L 346 74 M 278 150 L 278 166 L 294 166 M 362 150 L 362 166 L 346 166" fill="none" stroke="var(--accent-kinetic)" stroke-width="2" />
    <circle cx="320" cy="120" r="34" fill="none" stroke="var(--text-primary)" stroke-width="1.5" opacity="0.85" />
    <circle cx="320" cy="120" r="6" fill="var(--accent-kinetic)" />
    <rect x="28" y="192" width="584" height="32" rx="7" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" />
    <text x="44" y="212" fill="var(--text-secondary)" font-size="11" font-family="var(--font-mono)">
      SHUTTERSTOCK SERIES · SHARP AVIF/WEBP (.rotate + .keepIccProfile) · EXIF GPS STRIPPED ✓
    </text>
  </svg>
)}

{kind === 'cvTarget' && (
  <svg
    viewBox="0 0 480 210"
    class="w-full h-full block"
    role="img"
    aria-label="ISSF doelkaart met Computer Vision detectiekader voor precisietraining"
  >
    <rect width="480" height="210" rx="12" fill="var(--bg-surface-2)" />
    <circle cx="132" cy="105" r="70" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" stroke-width="1.5" />
    <circle cx="132" cy="105" r="52" fill="none" stroke="var(--border-subtle)" stroke-width="1" />
    <circle cx="132" cy="105" r="34" fill="none" stroke="var(--accent-telemetry)" stroke-width="1.5" />
    <circle cx="132" cy="105" r="15" fill="var(--accent-kinetic)" opacity="0.22" stroke="var(--accent-kinetic)" stroke-width="1.5" />
    <rect x="114" y="89" width="34" height="30" fill="none" stroke="var(--accent-status)" stroke-width="1.5" stroke-dasharray="3 2" />
    <circle cx="128" cy="100" r="2.5" fill="var(--accent-status)" />
    <circle cx="136" cy="106" r="2.5" fill="var(--accent-status)" />
    <circle cx="126" cy="110" r="2.5" fill="var(--accent-status)" />

    <g font-family="var(--font-mono)" font-size="11.5">
      <rect x="232" y="32" width="214" height="38" rx="8" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" />
      <text x="248" y="55" fill="var(--accent-status)">VSK / LEDO LIER · SAFETY</text>

      <rect x="232" y="86" width="214" height="38" rx="8" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" />
      <text x="248" y="109" fill="var(--text-primary)">FROM ZERO TO ITEM GUIDE</text>

      <rect x="232" y="140" width="214" height="38" rx="8" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" />
      <text x="248" y="163" fill="var(--accent-telemetry)">OPENCV SCORING R&amp;D</text>
    </g>
  </svg>
)}

{kind === 'iot' && (
  <svg
    viewBox="0 0 480 210"
    class="w-full h-full block"
    role="img"
    aria-label="Schematische weergave van ESP32-Public-Honeypot en PotHead deception telemetry"
  >
    <rect width="480" height="210" rx="12" fill="var(--bg-surface-2)" />
    <g stroke="var(--accent-telemetry)" stroke-width="1.5" stroke-dasharray="4 4">
      <line x1="145" y1="105" x2="255" y2="62" />
      <line x1="145" y1="105" x2="255" y2="148" />
    </g>
    <rect x="34" y="75" width="114" height="60" rx="10" fill="var(--bg-surface-1)" stroke="var(--accent-kinetic)" stroke-width="1.5" />
    <text x="91" y="102" text-anchor="middle" fill="var(--accent-kinetic)" font-family="var(--font-mono)" font-size="11.5" font-weight="600">LAB SENSOR</text>
    <text x="91" y="121" text-anchor="middle" fill="var(--text-secondary)" font-family="var(--font-mono)" font-size="10">ISOLATED VLAN</text>

    <rect x="255" y="34" width="190" height="56" rx="10" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" stroke-width="1.5" />
    <text x="350" y="59" text-anchor="middle" fill="var(--text-primary)" font-family="var(--font-mono)" font-size="12" font-weight="600">PotHead (PHP)</text>
    <text x="350" y="77" text-anchor="middle" fill="var(--accent-telemetry)" font-family="var(--font-mono)" font-size="10">HTTP / CREDENTIAL LOGS</text>

    <rect x="255" y="120" width="190" height="56" rx="10" fill="var(--bg-surface-1)" stroke="var(--border-subtle)" stroke-width="1.5" />
    <text x="350" y="145" text-anchor="middle" fill="var(--text-primary)" font-family="var(--font-mono)" font-size="12" font-weight="600">ESP32 Honeypot</text>
    <text x="350" y="163" text-anchor="middle" fill="var(--accent-status)" font-family="var(--font-mono)" font-size="10">C++ MICROCONTROLLER</text>
  </svg>
)}

{kind === 'pcb' && (
  <svg
    viewBox="0 0 480 210"
    class="w-full h-full block"
    role="img"
    aria-label="Schematische visualisatie van BeeHive IoT en Home+ custom PCB"
  >
    <rect width="480" height="210" rx="12" fill="var(--bg-surface-2)" />
    <rect x="44" y="32" width="392" height="146" rx="12" fill="var(--bg-surface-1)" stroke="var(--accent-status)" stroke-width="1.5" />
    <g stroke="var(--accent-kinetic)" stroke-width="2" fill="none">
      <polyline points="90,82 175,82 200,106 285,106" />
      <polyline points="90,130 165,130 190,145 310,145" />
    </g>
    <rect x="285" y="64" width="120" height="84" rx="8" fill="var(--bg-surface-2)" stroke="var(--accent-telemetry)" stroke-width="1.5" />
    <text x="345" y="102" text-anchor="middle" fill="var(--text-primary)" font-family="var(--font-mono)" font-size="11.5" font-weight="600">HOME+ PCB</text>
    <text x="345" y="122" text-anchor="middle" fill="var(--accent-status)" font-family="var(--font-mono)" font-size="10">BEEHIVE TELEMETRY</text>
    <circle cx="90" cy="82" r="7" fill="var(--accent-kinetic)" />
    <circle cx="90" cy="130" r="7" fill="var(--accent-telemetry)" />
  </svg>
)}
