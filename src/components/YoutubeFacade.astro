---
import type { Locale } from '@/i18n/routes';
import EditorialVisuals from '@/components/EditorialVisuals.astro';

interface Props {
  locale: Locale;
  videoId?: string;
  channelUrl?: string;
  photoKind?: 'hornet' | 'spa';
  title: string;
  playLabel: string;
  meta: string;
  notes: string;
}

const {
  locale,
  videoId = '',
  channelUrl = 'https://www.youtube.com/@QuintenMoto/videos',
  photoKind = 'hornet',
  title,
  playLabel,
  meta,
  notes,
} = Astro.props;

const isNl = locale === 'nl';
const hasVideoId = Boolean(videoId && videoId.trim().length >= 8);
---

<article class="editorial-card rounded-2xl overflow-hidden flex flex-col">
  <div class="relative aspect-video bg-surface-2 border-b border-border-subtle overflow-hidden">
    {hasVideoId ? (
      <lite-youtube
        videoid={videoId}
        playlabel={playLabel}
        params="rel=0&modestbranding=1"
        class="!max-w-none w-full h-full block"
      ></lite-youtube>
    ) : (
      <a
        href={channelUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={playLabel}
        class="group relative block w-full h-full focus-visible:outline-offset-[-3px]"
      >
        <EditorialVisuals
          kind={photoKind}
          locale={locale}
          sizes="(max-width: 768px) 96vw, 560px"
          class="transition-transform duration-500 group-hover:scale-[1.03]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-canvas/80 via-canvas/20 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="inline-flex items-center gap-2.5 rounded-full bg-canvas/90 border border-kinetic/60 px-5 py-2.5 text-sm font-semibold text-ink-primary shadow-lg transition-transform duration-200 group-hover:scale-105 group-hover:border-kinetic">
            <svg class="w-4 h-4 text-kinetic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
            {isNl ? 'Bekijk op @QuintenMoto' : 'Watch on @QuintenMoto'}
          </span>
        </div>
      </a>
    )}
  </div>

  <div class="p-6 space-y-3 flex-1 flex flex-col justify-between">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-wider text-kinetic">{meta}</p>
      <h3 class="mt-1.5 font-display text-lg font-bold text-ink-primary">{title}</h3>
      <p class="mt-2 text-sm text-ink-secondary leading-relaxed">{notes}</p>
    </div>

    <div class="pt-3 border-t border-border-subtle/70 flex items-center justify-between gap-2 text-xs">
      <a
        href={channelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-telemetry hover:text-kinetic transition-colors inline-flex items-center gap-1 min-h-[28px]"
      >
        {isNl ? 'Naar YouTube-kanaal @QuintenMoto →' : 'Open @QuintenMoto on YouTube →'}
      </a>
    </div>
  </div>
</article>

{hasVideoId && (
  <script>
    import 'lite-youtube-embed/src/lite-yt-embed.css';
    import 'lite-youtube-embed/src/lite-yt-embed.js';
  </script>
)}
