---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';
---

<EditorialLayout
  locale={locale}
  title={isNl ? 'Privacyverklaring — Quinten Desmyter' : 'Privacy Policy — Quinten Desmyter'}
  description={isNl
    ? 'Eenvoudige privacyverklaring voor de persoonlijke website van Quinten Desmyter: geen trackingcookies, geen advertenties en lokale lettertypes.'
    : 'Simple privacy notice for Quinten Desmyter’s personal website: no tracking cookies, no ads, and locally hosted fonts.'}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-8">
    <header class="space-y-3 border-b border-border-subtle pb-6">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-status">PRIVACY & GDPR / AVG</p>
      <h1 class="font-display text-3xl sm:text-4xl font-bold text-ink-primary">
        {isNl ? 'Gewoon lezen, zonder cookies of trackers.' : 'Just reading, without cookies or trackers.'}
      </h1>
      <p class="text-base text-ink-secondary leading-relaxed">
        {isNl
          ? 'Deze persoonlijke website plaatst geen trackingcookies, toont geen advertenties en verzamelt geen bezoekersprofielen.'
          : 'This personal website sets no tracking cookies, runs no ads, and builds no visitor profiles.'}
      </p>
    </header>

    <div class="editorial-prose">
      {isNl ? (
        <>
          <h2>1. Geen trackingcookies & lokale lettertypes</h2>
          <p>
            Er worden geen marketing-, analyse- of sessiecookies gebruikt. De lettertypes op deze website worden rechtstreeks vanaf dit domein geladen, zonder verbinding te maken met externe lettertypeservers.
          </p>
          <h2>2. Donkere of lichte weergave</h2>
          <p>
            Als je rechtsboven wisselt tussen de donkere en lichte weergave, onthoudt je browser alleen die kleurvoorkeur lokaal via <code>localStorage</code>. Daar zitten geen persoonsgegevens in en die voorkeur verlaat je toestel niet.
          </p>
          <h2>3. Externe links, kaarten & video’s</h2>
          <p>
            Externe kanalen zoals GitHub, YouTube of Bol.com openen pas wanneer je zelf op een link klikt. Ook de stratenkaart-achtergrond op de motorpagina wordt pas geladen als je daar expliciet voor kiest.
          </p>
          <h2>4. Beeldmateriaal & niet-commercieel karakter</h2>
          <p>
            Deze site is strikt persoonlijk en informatief (geen webshop of commerciële aanbiedingen). Gepubliceerde foto’s en routebestanden worden zorgvuldig nagekeken zodat persoonlijke gegevens en herkenbare derden buiten beeld blijven.
          </p>
          <h2>5. Jouw rechten onder de GDPR / AVG</h2>
          <p>
            Neem je contact op via een van de kanalen op de contactpagina, dan gebruik ik jouw bericht uitsluitend om te antwoorden. Je hebt steeds het recht om inzage of verwijdering van eventuele correspondentie te vragen. Voor klachten in België kan je terecht bij de Gegevensbeschermingsautoriteit (GBA).
          </p>
        </>
      ) : (
        <>
          <h2>1. No Tracking Cookies & Local Fonts</h2>
          <p>
            This website sets no marketing, analytics, or session cookies. All fonts are served directly from this domain without contacting external font providers.
          </p>
          <h2>2. Dark & Light Mode Preference</h2>
          <p>
            When you switch between dark and light mode, your browser stores only that theme choice locally in <code>localStorage</code>. It contains no personal data and never leaves your device.
          </p>
          <h2>3. External Links, Maps & Media</h2>
          <p>
            External services like GitHub, YouTube, or Bol.com are only contacted when you actively click a link. Optional street-map tiles on the motorcycle page load only if you switch them on.
          </p>
          <h2>4. Your GDPR Rights</h2>
          <p>
            This is a strictly personal, non-commercial site. If you reach out, your message is used solely to reply, and you may request access to or deletion of any correspondence at any time under EU GDPR rules.
          </p>
        </>
      )}
    </div>
  </div>
</EditorialLayout>
