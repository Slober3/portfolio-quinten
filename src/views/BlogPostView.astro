---
import { render, type CollectionEntry } from 'astro:content';
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import { STATIC_ROUTES, type Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'blog'>;
}

const { locale, entry } = Astro.props;
const isNl = locale === 'nl';
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const siteBase = String(Astro.site ?? 'https://quintendesmyter.be').replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: entry.data.title,
      description: entry.data.description,
      datePublished: entry.data.publishedAt,
      inLanguage: isNl ? 'nl-BE' : 'en',
      author: { '@type': 'Person', '@id': `${siteBase}/#person`, name: 'Quinten Desmyter' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}${STATIC_ROUTES.home[locale]}` },
        { '@type': 'ListItem', position: 2, name: isNl ? 'Notities' : 'Notes', item: `${siteBase}${STATIC_ROUTES.blog[locale]}` },
        { '@type': 'ListItem', position: 3, name: entry.data.title },
      ],
    },
  ],
};
---

<EditorialLayout
  locale={locale}
  title={`${entry.data.title} — Quinten Desmyter`}
  description={entry.data.description}
  jsonLd={jsonLd}
  showReadingProgress={true}
>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-10">
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-ink-secondary flex items-center gap-2">
      <a href={STATIC_ROUTES.home[locale]} class="hover:text-telemetry">Home</a>
      <span>/</span>
      <a href={STATIC_ROUTES.blog[locale]} class="hover:text-telemetry">
        {isNl ? 'Notities' : 'Notes'}
      </a>
      <span>/</span>
      <span class="text-ink-primary truncate">{entry.data.title}</span>
    </nav>

    <header class="space-y-4 border-b border-border-subtle pb-8">
      <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
        <span class="text-telemetry uppercase tracking-wider">{entry.data.category}</span>
        <span class="text-ink-secondary">·</span>
        <span class="text-kinetic">{entry.data.publishedAt}</span>
        <span class="text-ink-secondary">·</span>
        <span class="text-ink-secondary">{entry.data.readingMinutes} {isNl ? 'min leestijd' : 'min read'}</span>
      </div>
      <h1 class="font-display text-3xl sm:text-4xl font-bold leading-[1.15] text-ink-primary">
        {entry.data.title}
      </h1>
      <p class="text-lg text-ink-secondary leading-relaxed">{entry.data.description}</p>
    </header>

    {tocHeadings.length > 1 && (
      <nav
        aria-label={isNl ? 'Inhoudsopgave' : 'Table of contents'}
        class="rounded-2xl border border-border-subtle bg-surface-1 p-5 space-y-2"
      >
        <p class="font-mono text-[11px] uppercase tracking-wider text-kinetic">
          {isNl ? 'In dit artikel' : 'On this page'}
        </p>
        <ul class="space-y-1.5 text-sm">
          {tocHeadings.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="text-ink-secondary hover:text-telemetry transition-colors">
                → {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="editorial-prose">
      <Content />
    </div>

    <div class="border-t border-border-subtle pt-6 flex items-center justify-between gap-4">
      <a href={STATIC_ROUTES.blog[locale]} class="font-mono text-sm text-telemetry hover:underline">
        ← {isNl ? 'Alle notities' : 'All notes'}
      </a>
      <a href={STATIC_ROUTES.contact[locale]} class="font-mono text-xs text-kinetic hover:underline">
        {isNl ? 'Reageren of doorpraten →' : 'Get in touch →'}
      </a>
    </div>
  </article>
</EditorialLayout>
