---
import { render, type CollectionEntry } from 'astro:content';
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import EditorialVisuals from '@/components/EditorialVisuals.astro';
import WeaversFateWidget from '@/components/WeaversFateWidget.astro';
import { STATIC_ROUTES, type Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'projects'>;
}

const { locale, entry } = Astro.props;
const isNl = locale === 'nl';
const { Content } = await render(entry);
const isWeavers = entry.data.slug === 'weavers-fate';
const siteBase = String(Astro.site ?? 'https://quintendesmyter.be').replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: entry.data.title,
      description: entry.data.summary,
      inLanguage: isNl ? 'nl-BE' : 'en',
      author: { '@type': 'Person', '@id': `${siteBase}/#person`, name: 'Quinten Desmyter' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}${STATIC_ROUTES.home[locale]}` },
        { '@type': 'ListItem', position: 2, name: isNl ? 'Projecten' : 'Projects', item: `${siteBase}${STATIC_ROUTES.projects[locale]}` },
        { '@type': 'ListItem', position: 3, name: entry.data.title },
      ],
    },
  ],
};
---

<EditorialLayout
  locale={locale}
  title={`${entry.data.title} — Quinten Desmyter`}
  description={entry.data.summary}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-10">
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-ink-secondary flex items-center gap-2">
      <a href={STATIC_ROUTES.home[locale]} class="hover:text-telemetry">Home</a>
      <span>/</span>
      <a href={STATIC_ROUTES.projects[locale]} class="hover:text-telemetry">
        {isNl ? 'Projecten' : 'Projects'}
      </a>
      <span>/</span>
      <span class="text-ink-primary">{entry.data.title}</span>
    </nav>

    <header class="space-y-4 border-b border-border-subtle pb-8">
      <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
        <span class="text-kinetic uppercase tracking-wider">{entry.data.category}</span>
        <span class="text-ink-secondary">·</span>
        <span class="text-status">{entry.data.status}</span>
      </div>
      <h1 class="font-display text-3xl sm:text-5xl font-bold leading-[1.1] text-ink-primary">
        {entry.data.title}
      </h1>
      <p class="text-lg text-ink-secondary leading-relaxed">{entry.data.subtitle}</p>
      <div class="flex flex-wrap gap-2 pt-2">
        {entry.data.stack.map((item) => (
          <span class="rounded-full border border-border-subtle bg-surface-1 px-3 py-1 font-mono text-xs text-ink-primary">
            {item}
          </span>
        ))}
      </div>
    </header>

    <div class="aspect-[16/9] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
      <EditorialVisuals kind={entry.data.visualKind} locale={locale} eager={true} sizes="(max-width: 900px) 96vw, 840px" />
    </div>

    <div class="editorial-prose">
      <Content />
    </div>

    {isWeavers && <WeaversFateWidget locale={locale} />}

    {entry.data.githubUrl && (
      <div class="editorial-card rounded-2xl p-5 flex flex-wrap items-center justify-between gap-4">
        <span class="font-mono text-xs text-ink-secondary">
          {isNl ? 'Broncode & documentatie' : 'Source code & documentation'}
        </span>
        <a href={entry.data.githubUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-xs font-semibold text-telemetry hover:underline">
          {entry.data.githubUrl} ↗
        </a>
      </div>
    )}

    <div class="border-t border-border-subtle pt-6">
      <a href={STATIC_ROUTES.projects[locale]} class="font-mono text-sm text-telemetry hover:underline">
        ← {isNl ? 'Terug naar alle projecten' : 'Back to all projects'}
      </a>
    </div>
  </article>
</EditorialLayout>
