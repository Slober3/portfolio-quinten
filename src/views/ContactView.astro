---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';
---

<EditorialLayout
  locale={locale}
  title={isNl ? 'Contact — Quinten Desmyter' : 'Contact — Quinten Desmyter'}
  description={isNl
    ? 'Neem contact op met Quinten Desmyter voor vragen over onderwijs, workshops, open-source projecten of motorritten.'
    : 'Get in touch with Quinten Desmyter regarding teaching, workshops, open-source projects, or motorcycle routes.'}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-10">
    <header class="space-y-4 border-b border-border-subtle pb-8">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-telemetry">
        {isNl ? 'CONTACT · REGIO LIER / KEMPEN' : 'CONTACT · LIER / CAMPINE REGION'}
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold leading-[1.1] text-ink-primary">
        {isNl ? 'Even hallo zeggen of samenwerken?' : 'Want to say hello or collaborate?'}
      </h1>
      <p class="text-lg text-ink-secondary max-w-2xl leading-relaxed">
        {isNl
          ? 'Heb je een vraag over een lesmodule, RTC-workshop, boek, open-source project of een mooie motorroute in de Eifel? Laat gerust van je horen.'
          : 'Have a question about a course, workshop, book, open-source project, or a good backroad route in the Eifel? Feel free to reach out.'}
      </p>
    </header>

    <ContactForm locale={locale} />
  </div>
</EditorialLayout>
