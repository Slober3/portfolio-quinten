---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';
---

<EditorialLayout
  locale={locale}
  title={isNl ? 'Contact — Quinten Desmyter' : 'Contact — Quinten Desmyter'}
  description={isNl
    ? 'Neem veilig contact op met Quinten Desmyter via het statische contactformulier of publieke profielen (zonder blootgesteld mailto-adres).'
    : 'Reach Quinten Desmyter safely via the static contact form or public developer/creator profiles (zero exposed raw email addresses).'}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-10">
    <header class="space-y-4 border-b border-border-subtle pb-8">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-telemetry">
        {isNl ? 'CONTACT · REGIO LIER / KEMPEN' : 'CONTACT · LIER / CAMPINE REGION'}
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold leading-[1.1] text-ink-primary">
        {isNl ? 'Stuur een bericht.' : 'Start a conversation.'}
      </h1>
      <p class="text-lg text-ink-secondary max-w-2xl">
        {isNl
          ? 'Voor vragen rond IT-onderwijs, lezingen/workshops, open-source samenwerking of MotoAdventures. Beantwoord vanuit regio Lier / Kempen.'
          : 'For inquiries regarding IT education, workshops, open-source collaboration, or MotoAdventures. Based in the Lier / Campine region, Belgium.'}
      </p>
    </header>

    <ContactForm locale={locale} />
  </div>
</EditorialLayout>
