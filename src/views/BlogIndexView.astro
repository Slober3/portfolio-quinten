---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import { STATIC_ROUTES, type Locale } from '@/i18n/routes';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';

const posts = (await getCollection('blog', (e) => e.data.locale === locale)).sort((a, b) =>
  b.data.publishedAt.localeCompare(a.data.publishedAt)
);

const categories = Array.from(new Set(posts.map((p) => p.data.category)));
---

<EditorialLayout
  locale={locale}
  title={isNl ? 'Notities & artikelen — Quinten Desmyter' : 'Notes & Articles — Quinten Desmyter'}
  description={isNl
    ? 'Praktische artikelen en ervaringen over Flip the Classroom, Cisco CCNA netwerk-troubleshooting, PowerShell & Pester en ESP32-hardware.'
    : 'Practical articles and notes on Flipped Classroom teaching, Cisco CCNA troubleshooting, PowerShell & Pester, and ESP32 hardware.'}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-10">
    <header class="space-y-4 border-b border-border-subtle pb-8">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-telemetry">
        {isNl ? 'NOTITIES & ARTIKELEN' : 'NOTES & ARTICLES'}
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold leading-[1.1] text-ink-primary">
        {isNl ? 'Onderwijs, netwerken, automatisering & hardware.' : 'Teaching, networking, automation & hardware.'}
      </h1>
      <p class="text-lg text-ink-secondary max-w-3xl leading-relaxed">
        {isNl
          ? 'Korte, bruikbare stukken recht uit de lespraktijk: van netwerken debuggen en PowerShell-tests tot werken met microcontrollers.'
          : 'Practical notes straight from the lab and classroom: from network troubleshooting and PowerShell testing to microcontroller builds.'}
      </p>

      <!-- Interactive Category Filter -->
      <div class="flex flex-wrap gap-2 pt-2" role="group" aria-label={isNl ? 'Filter artikelen op categorie' : 'Filter articles by category'}>
        <button
          type="button"
          data-blog-filter="all"
          data-active="true"
          aria-pressed="true"
          class="rounded-xl border px-3.5 py-2 text-xs font-semibold transition-colors cursor-pointer min-h-[44px] bg-surface-1 text-ink-secondary border-border-subtle hover:text-ink-primary data-[active=true]:bg-telemetry data-[active=true]:text-canvas data-[active=true]:border-telemetry"
        >
          {isNl ? `Alles (${posts.length})` : `All (${posts.length})`}
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            data-blog-filter={cat}
            data-active="false"
            aria-pressed="false"
            class="rounded-xl border px-3.5 py-2 text-xs font-semibold transition-colors cursor-pointer min-h-[44px] bg-surface-1 text-ink-secondary border-border-subtle hover:text-ink-primary data-[active=true]:bg-telemetry data-[active=true]:text-canvas data-[active=true]:border-telemetry"
          >
            {cat}
          </button>
        ))}
      </div>
    </header>

    <div class="divide-y divide-border-subtle border-y border-border-subtle">
      {posts.map((post) => {
        const href = `${STATIC_ROUTES.blog[locale]}${post.data.slug}/`;
        return (
          <article data-blog-card data-blog-cat={post.data.category} class="py-8 grid grid-cols-1 md:grid-cols-[170px_1fr] gap-4 md:gap-8">
            <div class="font-mono text-xs space-y-1 text-ink-secondary">
              <p class="text-kinetic font-semibold">{post.data.publishedAt}</p>
              <p>{post.data.readingMinutes} {isNl ? 'min leestijd' : 'min read'}</p>
            </div>
            <div class="space-y-3">
              <p class="font-mono text-[11px] uppercase tracking-wider text-telemetry">{post.data.category}</p>
              <h2 class="font-display text-2xl font-bold text-ink-primary">
                <a href={href} class="hover:text-kinetic transition-colors">{post.data.title}</a>
              </h2>
              <p class="text-base text-ink-secondary leading-relaxed">{post.data.description}</p>
              <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
                <div class="flex flex-wrap gap-1.5">
                  {post.data.tags.map((t) => (
                    <span class="rounded-full border border-border-subtle bg-surface-1 px-2.5 py-0.5 font-mono text-[11px] text-ink-secondary">
                      {t}
                    </span>
                  ))}
                </div>
                <a href={href} class="font-mono text-xs font-semibold text-telemetry hover:underline">
                  {isNl ? 'Artikel lezen →' : 'Read article →'}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <script is:inline>
    (() => {
      const bindBlogFilters = () => {
        const buttons = document.querySelectorAll('[data-blog-filter]');
        const cards = document.querySelectorAll('[data-blog-card]');
        buttons.forEach((btn) => {
          if (btn.dataset.bound === '1') return;
          btn.dataset.bound = '1';
          btn.addEventListener('click', () => {
            const cat = btn.getAttribute('data-blog-filter') || 'all';
            cards.forEach((card) => {
              const show = cat === 'all' || card.getAttribute('data-blog-cat') === cat;
              card.classList.toggle('hidden', !show);
            });
            buttons.forEach((b) => {
              const active = b === btn;
              b.setAttribute('aria-pressed', String(active));
              b.setAttribute('data-active', String(active));
            });
          });
        });
      };
      document.addEventListener('astro:page-load', bindBlogFilters);
    })();
  </script>
</EditorialLayout>
