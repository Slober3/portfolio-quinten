---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import { STATIC_ROUTES, type Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';
---

<EditorialLayout
  locale={locale}
  title={isNl ? '404 — Pagina niet gevonden | Quinten Desmyter' : '404 — Page Not Found | Quinten Desmyter'}
  description={isNl ? 'De opgevraagde pagina werd niet gevonden.' : 'The requested page could not be found.'}
  noindex={true}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-24 text-center space-y-6">
    <p class="font-mono text-sm uppercase tracking-widest text-kinetic">HTTP 404</p>
    <h1 class="font-display text-4xl sm:text-5xl font-bold text-ink-primary">
      {isNl ? 'Route niet gevonden.' : 'Route not found.'}
    </h1>
    <p class="text-base text-ink-secondary max-w-lg mx-auto">
      {isNl
        ? 'Deze pagina bestaat niet of werd verplaatst. Kies hieronder een startpunt in het Nederlands of Engels.'
        : 'This route does not exist or has moved. Choose a starting point in Dutch or English below.'}
    </p>
    <div class="flex flex-wrap justify-center gap-3 pt-2">
      <a href={STATIC_ROUTES.home.nl} class="rounded-full bg-kinetic px-6 py-3 text-sm font-semibold text-canvas hover:bg-kinetic-hover transition-colors min-h-[44px]">
        Naar /nl/ (Nederlands)
      </a>
      <a href={STATIC_ROUTES.home.en} class="rounded-full border border-border-subtle bg-surface-1 px-6 py-3 text-sm font-semibold text-ink-primary hover:border-telemetry transition-colors min-h-[44px]">
        Go to /en/ (English)
      </a>
    </div>
  </div>
</EditorialLayout>
