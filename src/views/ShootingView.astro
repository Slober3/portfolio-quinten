---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import EditorialVisuals from '@/components/EditorialVisuals.astro';
import { STATIC_ROUTES, type Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';

const legalSteps = [
  {
    step: '01',
    title: isNl ? 'Aansluiten bij een erkende schietclub & Veiligheidsbasis' : 'Join a Recognized Club & Safety Foundation',
    body: isNl
      ? 'Start altijd bij een erkende club (zoals LEDO Lier binnen de Vlaamse Schietsportkoepel / VSK). Je leert eerst de vier universele vuurwapenveiligheidsregels, veilige wapenhantering en baandiscipline onder begeleiding van clubinstructeurs.'
      : 'Start at an accredited club (such as LEDO Lier under the Flemish Sport Shooting Federation / VSK), mastering the four universal firearm safety rules and range commands under instructor supervision.',
  },
  {
    step: '02',
    title: isNl ? 'Voorlopige Sportschutterslicentie (VSSL) & Model VL3' : 'Preliminary License (VSSL) & Model VL3',
    body: isNl
      ? 'Via de federatie vraag je een voorlopige sportschutterslicentie aan met uittreksel uit het strafregister (Model 596.1-5A) en medisch attest. Gedurende minstens 6 maanden bouw je onder toezicht praktijkervaring op per wapencategorie (zoals vastgelegd op het opleidingsattest / Model VL3).'
      : 'Through the federation you obtain a preliminary license backed by a clean background extract and medical certificate, logging supervised range sessions over at least 6 months per category (VL3 training record).',
  },
  {
    step: '03',
    title: isNl ? 'Theoretische & Praktische Proef → Definitieve SSL' : 'Theory & Practical Exams → Full SSL',
    body: isNl
      ? 'Je legt een officiële theoretische proef af over de Belgische Wapenwet en veiligheidsregels, gevolgd door een praktische proef per gewenste categorie (bv. revolver, pistool, gladloop of getrokken loop). Na slagen ontvang je jouw definitieve Sportschutterslicentie (SSL).'
      : 'Pass the official Belgian Weapons Act theory exam and category-specific practical safety exam to receive your full Sport Shooter License (SSL).',
  },
  {
    step: '04',
    title: isNl ? 'Model 9 vs. Model 4 & 12 Jaarlijkse Schietbeurten' : 'Model 9 vs. Model 4 & 12 Annual Sessions',
    body: isNl
      ? 'Bepaalde sportwapens kunnen met een geldige SSL via Model 9 worden geregistreerd; voor andere kalibers of types vraag je een voorafgaande Model 4-vergunning aan bij de provinciegouverneur. Om je SSL geldig te houden, registreer je minstens 12 geldige schietbeurten per jaar gespreid over minstens twee trimesters.'
      : 'Eligible sporting firearms can be registered via Model 9 under a valid SSL, whereas other categories require prior Model 4 authorization from the provincial governor. Keeping an SSL active requires logging at least 12 valid range sessions per year across multiple quarters.',
  },
  {
    step: '05',
    title: isNl ? 'Veilige Bewaring & Vijfjaarlijkse Controle' : 'Safe Storage & Five-Year Statutory Check',
    body: isNl
      ? 'Wettelijke opslagvereisten (afgesloten bewaring, gescheiden van munitie conform het KB en afhankelijk van aantallen) en de verplichte vijfjaarlijkse hertoetsing zorgen dat verantwoord bezit altijd aantoonbaar blijft.'
      : 'Strict statutory storage rules (locked storage separated from ammunition per Royal Decree thresholds) and five-year administrative checks ensure continued legal compliance.',
  },
];
---

<EditorialLayout
  locale={locale}
  title={isNl ? 'Schietsport, Wetgeving & Computer Vision — Quinten Desmyter' : 'Sport Shooting, Legislation & Computer Vision — Quinten Desmyter'}
  description={isNl
    ? 'VSK-sportschutter bij LEDO Lier: focus op vuurwapenveiligheid, de herwerkte Belgische wetgevingsgids "From Zero to Item", persoonlijke trainingsdata en Computer Vision R&D.'
    : 'VSK sport shooter at LEDO Lier: safety-first training, Belgian legislation guide "From Zero to Item", personal training logs, and Computer Vision R&D.'}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-14">
    <header class="space-y-5 border-b border-border-subtle pb-10">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-status">
        VSK / LEDO LIER · {isNl ? 'VEILIGHEID & PRECISIE' : 'SAFETY & PRECISION'}
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold leading-[1.1] text-ink-primary">
        {isNl
          ? 'Schietsport, Belgische Wetgeving & Computer Vision.'
          : 'Sport Shooting, Belgian Legislation & Computer Vision.'}
      </h1>
      <p class="text-lg text-ink-secondary max-w-3xl leading-relaxed">
        {isNl
          ? 'Als gelicentieerd VSK-sportschutter bij LEDO Lier benader ik de discipline vanuit veiligheid, ademhaling en techniek. Vanuit mijn eigen trainingsregistratie ontstond zowel een heldere wetgevingsgids als technisch onderzoek rond objectieve doelkaart-analyse.'
          : 'As a licensed VSK sport shooter at LEDO Lier, I approach precision shooting through safety, discipline, and technique — combining a clear Belgian regulatory guide with technical R&D into target scoring.'}
      </p>
    </header>

    <div class="aspect-[21/9] overflow-hidden rounded-2xl border border-border-subtle">
      <EditorialVisuals kind="cvTarget" />
    </div>

    <!-- Reworked Web Guide: From Zero to Item -->
    <section class="space-y-8">
      <div class="space-y-2">
        <p class="font-mono text-xs uppercase tracking-wider text-kinetic">
          {isNl ? 'HERWERKTE WEBGIDS · BELGISCHE WAPENWETGEVING' : 'REWORKED WEB GUIDE · BELGIAN REGULATION'}
        </p>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-ink-primary">
          “From Zero to Item” — {isNl ? 'Stappenplan & Veiligheid voor Starters' : 'Safety & Regulatory Roadmap for Starters'}
        </h2>
        <p class="text-sm sm:text-base text-ink-secondary">
          {isNl
            ? 'Een nuchtere samenvatting van het wettelijk kader voor aspirant-sportschutters in Vlaanderen (VSK), zonder onnodig jargon en met respect voor strikte veiligheidsnormen.'
            : 'A practical overview of the Flemish regulatory journey for sport shooters, emphasizing safety discipline and statutory accuracy.'}
        </p>
      </div>

      <div class="divide-y divide-border-subtle border-y border-border-subtle">
        {legalSteps.map((s) => (
          <article class="py-6 grid grid-cols-1 md:grid-cols-[120px_1fr] gap-3 md:gap-8">
            <span class="font-mono text-lg font-bold text-kinetic">{s.step}</span>
            <div class="space-y-2">
              <h3 class="font-display text-xl font-bold text-ink-primary">{s.title}</h3>
              <p class="text-sm sm:text-base text-ink-secondary leading-relaxed">{s.body}</p>
            </div>
          </article>
        ))}
      </div>

      <aside class="rounded-xl border border-border-subtle bg-surface-1 p-5 text-xs sm:text-sm text-ink-secondary leading-relaxed">
        <strong class="text-ink-primary">
          {isNl ? 'Wettelijk kader (Belgische Wapenwet van 8 juni 2006):' : 'Legal notice (Belgian Weapons Act of 8 June 2006):'}
        </strong>{' '}
        {isNl
          ? 'Deze pagina is uitsluitend informatief en educatief bedoeld. Er worden op deze website nooit vuurwapens of munitie te koop aangeboden (conform Art. 19 Wapenwet). Raadpleeg steeds de actuele publicaties van de VSK en FOD Justitie voor bindende wetteksten.'
          : 'This page is strictly educational and informational. No firearms or ammunition are ever offered for sale here (per Art. 19 of the Belgian Weapons Act). Always consult official VSK and Federal Justice texts for binding legal obligations.'}
      </aside>
    </section>

    <!-- Honest Personal Stats & OpenCV R&D Link -->
    <section class="editorial-card rounded-2xl p-6 sm:p-8 space-y-4">
      <p class="font-mono text-xs uppercase tracking-wider text-telemetry">
        {isNl ? 'PERSOONLIJKE TRAININGSDATA & OPENCV VERKENNING' : 'PERSONAL TRAINING STATS & OPENCV EXPLORATION'}
      </p>
      <h2 class="font-display text-2xl font-bold text-ink-primary">
        {isNl
          ? 'Van persoonlijke schietstatistieken naar geautomatiseerde kaartanalyse'
          : 'From personal shooting stats to automated target analysis'}
      </h2>
      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed">
        {isNl
          ? 'Om mijn persoonlijke voortgang op de baan op te volgen gebruik ik bestaande tools zoals RangeBook en Shooting Companion puur voor eigen gebruik. Die structuur inspireert mijn eigen technische verkenning rond Computer Vision (OpenCV) voor het automatisch rechtzetten en scoren van ISSF 25m/50m papieren doelkaarten.'
          : 'To track my own training statistics privately, I use existing tools such as RangeBook and Shooting Companion purely for personal use. That workflow inspires ongoing Computer Vision R&D around automating perspective correction and ISSF 25m/50m target evaluation.'}
      </p>
      <div class="pt-1">
        <a
          href={`${STATIC_ROUTES.projects[locale]}${isNl ? 'schietsport-computer-vision/' : 'shooting-computer-vision/'}`}
          class="font-mono text-xs font-semibold text-telemetry hover:underline"
        >
          {isNl ? 'Lees het volledige Computer Vision dossier →' : 'Read the full Computer Vision dossier →'}
        </a>
      </div>
    </section>
  </div>
</EditorialLayout>
