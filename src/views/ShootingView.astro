---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import { STATIC_ROUTES, type Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';

const legalSteps = [
  {
    step: '01',
    title: isNl ? 'Aansluiten bij een erkende schietclub & veiligheidsbasis' : 'Join an accredited club & learn safety fundamentals',
    body: isNl
      ? 'Start altijd bij een erkende club (zoals LEDO Lier binnen de Vlaamse Schietsportkoepel / VSK). Je leert eerst de vier universele veiligheidsregels, correcte hantering en baandiscipline onder begeleiding van clubinstructeurs.'
      : 'Start at an accredited club (such as LEDO Lier under the Flemish Sport Shooting Federation / VSK), mastering the four universal safety rules and range discipline under instructor supervision.',
  },
  {
    step: '02',
    title: isNl ? 'Voorlopige Sportschutterslicentie (VSSL) & Model VL3' : 'Preliminary License (VSSL) & Model VL3',
    body: isNl
      ? 'Via de federatie vraag je een voorlopige sportschutterslicentie aan met uittreksel uit het strafregister (Model 596.1-5A) en medisch attest. Gedurende minstens 6 maanden bouw je onder toezicht praktijkervaring op per wapencategorie (bijgehouden op Model VL3).'
      : 'Through the federation you request a preliminary license supported by a clean background extract and medical certificate, logging supervised range sessions over at least 6 months per category (VL3 training record).',
  },
  {
    step: '03',
    title: isNl ? 'Theoretische & praktische proef → definitieve SSL' : 'Theory & practical exams → full SSL',
    body: isNl
      ? 'Je legt een officiële theoretische proef af over de Belgische Wapenwet en veiligheidsregels, gevolgd door een praktische proef per gewenste categorie (bv. revolver, pistool, gladloop of getrokken loop). Na slagen ontvang je jouw definitieve Sportschutterslicentie (SSL).'
      : 'Pass the official Belgian Weapons Act theory exam and category-specific practical safety exam to receive your full Sport Shooter License (SSL).',
  },
  {
    step: '04',
    title: isNl ? 'Model 9 vs. Model 4 & 12 jaarlijkse schietbeurten' : 'Model 9 vs. Model 4 & 12 annual sessions',
    body: isNl
      ? 'Bepaalde sportwapens kunnen met een geldige SSL via Model 9 worden geregistreerd; voor andere kalibers of types vraag je vooraf een Model 4-vergunning aan bij de provinciegouverneur. Om je SSL actief te houden, registreer je minstens 12 geldige schietbeurten per jaar gespreid over minstens twee trimesters.'
      : 'Eligible sporting firearms can be registered via Model 9 under a valid SSL, whereas other categories require prior Model 4 authorization from the provincial governor. Keeping an SSL valid requires logging at least 12 range sessions per year across multiple quarters.',
  },
  {
    step: '05',
    title: isNl ? 'Veilige bewaring & vijfjaarlijkse controle' : 'Safe storage & five-year statutory check',
    body: isNl
      ? 'Wettelijke opslagvereisten (afgesloten bewaring, gescheiden van munitie conform het KB) en de verplichte vijfjaarlijkse hertoetsing zorgen ervoor dat verantwoord bezit altijd aantoonbaar blijft.'
      : 'Strict statutory storage rules (locked storage separated from ammunition per Royal Decree) and five-year administrative checks ensure ongoing legal compliance.',
  },
];
---

<EditorialLayout
  locale={locale}
  title={isNl ? 'Schietsport & Belgische wetgeving — Quinten Desmyter' : 'Sport Shooting & Belgian Legislation — Quinten Desmyter'}
  description={isNl
    ? 'VSK-sportschutter bij LEDO Lier: de gids "From Zero to Item" over de Belgische wapenwetgeving, persoonlijke trainingsstatistieken en beeldherkenning op schietschijven.'
    : 'VSK sport shooter at LEDO Lier: the "From Zero to Item" guide to Belgian regulation, personal training logs, and target-scoring vision experiments.'}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    <header class="editorial-card rounded-2xl p-6 sm:p-8 space-y-4">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-status">
        VSK / LEDO LIER · {isNl ? 'VEILIGHEID & PRECISIE' : 'SAFETY & PRECISION'}
      </p>
      <h1 class="font-display text-3xl sm:text-5xl font-bold leading-[1.08] text-ink-primary">
        {isNl
          ? 'Schietsport, Belgische wetgeving & trainingsdata.'
          : 'Sport shooting, Belgian regulation & training data.'}
      </h1>
      <p class="text-base sm:text-lg text-ink-secondary max-w-3xl leading-relaxed">
        {isNl
          ? 'Als gelicentieerd VSK-sportschutter bij LEDO Lier trek ik naar de schietstand voor rust, ademhaling en herhaalbare precisie. Omdat startende schutters vaak door de bomen het wettelijke bos niet meer zien, schreef ik een helder stappenplan — en kijk ik vanuit mijn IT-achtergrond naar geautomatiseerde doelkaart-analyse.'
          : 'As a licensed VSK sport shooter at LEDO Lier, I enjoy the sport for its calm focus, breathing discipline, and repeatable technique. Because newcomers often find Belgian regulations confusing, I put together a clear roadmap — alongside an IT side project exploring automated target scoring.'}
      </p>
    </header>

    <!-- Web Guide: From Zero to Item -->
    <section class="space-y-6">
      <div class="border-b border-border-subtle pb-3 space-y-1">
        <p class="font-mono text-xs uppercase tracking-wider text-kinetic">
          {isNl ? 'STAPPENPLAN · BELGISCHE WAPENWETGEVING' : 'ROADMAP · BELGIAN REGULATION'}
        </p>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-ink-primary">
          “From Zero to Item” — {isNl ? 'Van eerste proefbeurt tot sportschutterslicentie' : 'From first supervised visit to full sport license'}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {legalSteps.map((s) => (
          <article class="editorial-card rounded-2xl p-6 space-y-2">
            <span class="font-mono text-sm font-bold text-kinetic">{s.step}</span>
            <h3 class="font-display text-lg font-bold text-ink-primary">{s.title}</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">{s.body}</p>
          </article>
        ))}

        <!-- 6th Card fills the 2-col grid evenly with the Computer Vision link! -->
        <article class="editorial-card rounded-2xl p-6 flex flex-col justify-between gap-4 border-telemetry/40">
          <div class="space-y-2">
            <span class="font-mono text-xs uppercase tracking-wider text-telemetry">
              {isNl ? 'EIGEN TRAININGSDATA & OPENCV' : 'PERSONAL STATS & OPENCV'}
            </span>
            <h3 class="font-display text-lg font-bold text-ink-primary">
              {isNl ? 'RangeBook, Shooting Companion & doelkaart-analyse' : 'RangeBook, Shooting Companion & target scoring'}
            </h3>
            <p class="text-sm text-ink-secondary leading-relaxed">
              {isNl
                ? 'Om mijn eigen vooruitgang op de baan bij te houden gebruik ik bestaande apps zoals RangeBook en Shooting Companion puur voor eigen gebruik. Vanuit die praktijk verken ik met OpenCV automatische scoreberekening op ISSF-doelkaarten.'
                : 'To track my own range sessions privately, I use existing apps like RangeBook and Shooting Companion purely for personal stats, inspiring an OpenCV side project around ISSF target analysis.'}
            </p>
          </div>
          <a
            href={`${STATIC_ROUTES.projects[locale]}${isNl ? 'schietsport-computer-vision/' : 'shooting-computer-vision/'}`}
            class="font-mono text-xs font-semibold text-telemetry hover:underline pt-2 border-t border-border-subtle"
          >
            {isNl ? 'Lees meer over het Computer Vision project →' : 'Read about the Computer Vision project →'}
          </a>
        </article>
      </div>

      <aside class="rounded-xl border border-border-subtle bg-surface-1 p-5 text-xs sm:text-sm text-ink-secondary leading-relaxed">
        <strong class="text-ink-primary">
          {isNl ? 'Wettelijk kader (Belgische Wapenwet van 8 juni 2006):' : 'Legal notice (Belgian Weapons Act of 8 June 2006):'}
        </strong>{' '}
        {isNl
          ? 'Deze pagina is uitsluitend informatief en educatief bedoeld. Er worden op deze website nooit vuurwapens of munitie te koop aangeboden (conform Art. 19 Wapenwet). Raadpleeg steeds de actuele publicaties van de VSK en FOD Justitie voor bindende wetteksten.'
          : 'This page is strictly educational and informational. No firearms or ammunition are ever offered for sale here (per Art. 19 of the Belgian Weapons Act). Always consult official VSK and Federal Justice texts for binding legal obligations.'}
      </aside>
    </section>
  </div>
</EditorialLayout>
