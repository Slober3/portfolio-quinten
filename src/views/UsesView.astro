---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import EditorialVisuals from '@/components/EditorialVisuals.astro';
import type { Locale } from '@/i18n/routes';
import { usesCategories } from '@/data/usesAndNow';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';
---

<EditorialLayout
  locale={locale}
  title={`/uses — Quinten Desmyter`}
  description={isNl
    ? 'Overzicht van mijn dagelijkse uitrusting: Blue Yeti microfoon op boom arm, Honda CB750 Hornet, DJI camera-opstelling, laser-cutting en Hokema B17 kalimba.'
    : 'My everyday setup: Blue Yeti microphone on boom arm, Honda CB750 Hornet, DJI camera kit, laser-cutting tools, and Hokema B17 kalimba.'}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    <header class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <div class="lg:col-span-7 editorial-card rounded-2xl p-6 sm:p-8 flex flex-col justify-center space-y-3">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-telemetry">/USES · {isNl ? 'UITRUSTING' : 'GEAR & TOOLS'}</p>
        <h1 class="font-display text-3xl sm:text-5xl font-bold leading-[1.08] text-ink-primary">
          {isNl ? 'Wat ik dagelijks gebruik.' : 'What I use every day.'}
        </h1>
        <p class="text-base text-ink-secondary leading-relaxed">
          {isNl
            ? 'Ik krijg vaak vragen over mijn microfoon tijdens lessen, mijn camera’s op de motor of het materiaal op mijn werktafel. Dit is het vaste materiaal waar ik graag mee werk.'
            : 'People often ask about my desk microphone, my motorcycle camera rig, or the tools on my craft table. Here is the dependable kit I reach for every week.'}
        </p>
      </div>
      <div class="lg:col-span-5 aspect-[16/10] lg:aspect-auto overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
        <EditorialVisuals kind="pcb" locale={locale} eager={true} sizes="(max-width: 1024px) 96vw, 460px" />
      </div>
    </header>

    <div class="space-y-10">
      {usesCategories.map((cat) => (
        <section class="space-y-4">
          <h2 class="font-display text-2xl font-bold text-ink-primary border-b border-border-subtle pb-2.5">
            {cat.title[locale]}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {cat.items.map((item) => (
              <article class="editorial-card rounded-2xl p-5 space-y-1.5">
                <h3 class="font-display text-lg font-bold text-ink-primary">{item.name}</h3>
                <p class="text-sm text-ink-secondary leading-relaxed">{item.detail[locale]}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</EditorialLayout>
