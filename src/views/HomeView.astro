---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import EditorialVisuals from '@/components/EditorialVisuals.astro';
import { STATIC_ROUTES, type Locale } from '@/i18n/routes';
import { books } from '@/data/profile';
import { motoProfile } from '@/data/moto';
import { nowSection } from '@/data/usesAndNow';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';

const siteBase = String(Astro.site ?? 'https://quintendesmyter.be').replace(/\/$/, '');
const allProjects = (await getCollection('projects', (e) => e.data.locale === locale && e.data.featuredOnHome))
  .sort((a, b) => a.data.order - b.data.order);
const latestPosts = (await getCollection('blog', (e) => e.data.locale === locale))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
  .slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: `${siteBase}${STATIC_ROUTES.home[locale]}`,
  mainEntity: {
    '@type': 'Person',
    '@id': `${siteBase}/#person`,
    name: 'Quinten Desmyter',
    url: `${siteBase}${STATIC_ROUTES.home[locale]}`,
    jobTitle: isNl ? 'Praktijklector Cloud, Netwerken & Cybersecurity' : 'Senior Lecturer Cloud, Networking & Cybersecurity',
    worksFor: {
      '@type': 'CollegeOrUniversity',
      name: 'Thomas More Hogeschool (IT Factory, Campus Geel)',
    },
    homeLocation: {
      '@type': 'Place',
      name: isNl ? 'Regio Lier / Kempen, België' : 'Lier / Campine Region, Belgium',
    },
    sameAs: ['https://github.com/Slober3', 'https://www.youtube.com/@QuintenMoto'],
  },
};
---

<EditorialLayout
  locale={locale}
  title={isNl
    ? 'Quinten Desmyter — Systemen, Precisie & Vrijheid'
    : 'Quinten Desmyter — Systems, Precision & Freedom'}
  description={isNl
    ? 'Persoonlijke website van Quinten Desmyter: praktijklector IT aan Thomas More (Campus Geel), auteur, motorrijder op een Honda CB750 Hornet, fotograaf en maker.'
    : 'Personal website of Quinten Desmyter: IT lecturer at Thomas More (Geel Campus), author, Honda CB750 Hornet rider, photographer, and maker.'}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-16">
    <!-- Personal Split Editorial Hero with Real Photography -->
    <section class="pb-14 border-b border-border-subtle">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-telemetry">
            {isNl
              ? 'QUINTEN DESMYTER · REGIO LIER / KEMPEN, BELGIË'
              : 'QUINTEN DESMYTER · LIER / CAMPINE REGION, BELGIUM'}
          </p>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-[3.2rem] font-bold leading-[1.08] text-ink-primary">
            {isNl
              ? 'Hoi, ik ben Quinten. Ik geef les in IT, bouw eigen projecten en trek er graag op uit.'
              : 'Hi, I’m Quinten. I teach IT, build side projects, and love chasing twisty roads.'}
          </h1>

          <p class="text-lg text-ink-secondary leading-relaxed max-w-2xl">
            {isNl
              ? 'Overdag help ik studenten aan Thomas More (Campus Geel) hun weg te vinden in cloud, netwerken en cybersecurity. Buiten het klaslokaal vind je mij op mijn Honda CB750 Hornet in de Ardennen of Eifel, met een camera in het bos, aan een eigen bordspel of boven een printplaat op mijn werkbank.'
              : 'By day, I help students at Thomas More (Geel Campus) get hands-on with cloud, networking, and cybersecurity. Off the clock, you’ll find me on my Honda CB750 Hornet in the Ardennes or Eifel, out in the woods with a macro lens, refining a tabletop dice game, or soldering a custom circuit board.'}
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3.5">
            <a
              href={STATIC_ROUTES.about[locale]}
              class="inline-flex items-center rounded-full bg-kinetic px-6 py-3 text-sm font-semibold text-canvas hover:bg-kinetic-hover transition-colors min-h-[44px]"
            >
              {isNl ? 'Leer mij kennen' : 'About me'}
            </a>
            <a
              href={STATIC_ROUTES.tech[locale]}
              class="inline-flex items-center rounded-full border border-border-subtle bg-surface-1 px-6 py-3 text-sm font-semibold text-ink-primary hover:border-telemetry transition-colors min-h-[44px]"
            >
              {isNl ? 'Onderwijs & IT' : 'Teaching & IT'}
            </a>
            <a
              href="#ch-03"
              class="inline-flex items-center text-sm font-semibold text-telemetry hover:text-kinetic px-2 py-2 transition-colors"
            >
              {isNl ? 'Motorritten & foto’s ↓' : 'Motorcycles & photos ↓'}
            </a>
          </div>
        </div>

        <figure class="lg:col-span-5">
          <div class="aspect-[16/11] overflow-hidden rounded-2xl border border-border-subtle shadow-lg bg-surface-2">
            <EditorialVisuals kind="cloud" locale={locale} eager={true} sizes="(max-width: 1024px) 96vw, 480px" />
          </div>
          <figcaption class="mt-3 flex items-center justify-between gap-2 font-mono text-[11px] text-ink-secondary">
            <span>{isNl ? 'Systemen, Precisie & Vrijheid' : 'Systems, Precision & Freedom'}</span>
            <span>{isNl ? 'Kempen · Campus Geel' : 'Campine · Geel Campus'}</span>
          </figcaption>
        </figure>
      </div>

      <!-- Quiet Fact Strip -->
      <dl class="mt-12 grid grid-cols-2 lg:grid-cols-4 gap-6 border-t border-border-subtle pt-8">
        <div>
          <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-secondary">
            {isNl ? 'Dagelijks werk' : 'Day job'}
          </dt>
          <dd class="mt-1 font-display text-base font-semibold text-ink-primary">Thomas More IT Factory · RTC</dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-secondary">
            {isNl ? 'Boeken' : 'Books'}
          </dt>
          <dd class="mt-1 font-display text-base font-semibold text-ink-primary">
            {isNl ? 'Cybersecurity & Python (2× ISBN)' : 'Cybersecurity & Python (2× ISBN)'}
          </dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-secondary">
            {isNl ? 'Op twee wielen' : 'On two wheels'}
          </dt>
          <dd class="mt-1 font-display text-base font-semibold text-ink-primary">{motoProfile.bike}</dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-secondary">
            {isNl ? 'Buiten de uren' : 'Off the clock'}
          </dt>
          <dd class="mt-1 font-display text-base font-semibold text-ink-primary">
            {isNl ? 'Fotografie, spelontwerp & Stitch' : 'Photography, games & Stitch'}
          </dd>
        </div>
      </dl>
    </section>

    <!-- Editorial Chapters with Sticky Left Chapter Rail -->
    <div class="mt-14 grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-10 lg:gap-14 items-start">
      <aside
        aria-label={isNl ? 'Inhoud van deze pagina' : 'Page chapters'}
        class="hidden lg:block sticky top-24 space-y-3 border-l border-border-subtle pl-4"
      >
        <p class="font-mono text-[11px] uppercase tracking-widest text-ink-secondary mb-4">
          {isNl ? 'Op deze pagina' : 'On this page'}
        </p>
        <a href="#ch-01" data-chapter-link="ch-01" data-active="true" class="block py-1 text-sm transition-colors text-ink-secondary hover:text-telemetry data-[active=true]:text-ink-primary data-[active=true]:font-semibold">
          01 · {isNl ? 'Onderwijs & IT' : 'Teaching & IT'}
        </a>
        <a href="#ch-02" data-chapter-link="ch-02" data-active="false" class="block py-1 text-sm transition-colors text-ink-secondary hover:text-telemetry data-[active=true]:text-ink-primary data-[active=true]:font-semibold">
          02 · {isNl ? 'Eigen projecten' : 'Side projects'}
        </a>
        <a href="#ch-03" data-chapter-link="ch-03" data-active="false" class="block py-1 text-sm transition-colors text-ink-secondary hover:text-kinetic data-[active=true]:text-kinetic data-[active=true]:font-semibold">
          03 · {isNl ? 'Motorritten' : 'Motorcycles'}
        </a>
        <a href="#ch-04" data-chapter-link="ch-04" data-active="false" class="block py-1 text-sm transition-colors text-ink-secondary hover:text-status data-[active=true]:text-status data-[active=true]:font-semibold">
          04 · {isNl ? 'Fotografie & nu' : 'Photos & now'}
        </a>
      </aside>

      <div class="space-y-24">
        <!-- Chapter 01: Teaching, Books & Hardware -->
        <section id="ch-01" class="space-y-8 scroll-reveal">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="space-y-2">
              <p class="font-mono text-xs text-telemetry">01 · {isNl ? 'WERK & PUBLICATIES' : 'WORK & PUBLICATIONS'}</p>
              <h2 class="font-display text-2xl sm:text-3xl font-bold text-ink-primary">
                {isNl ? 'Lesgeven in cloud, netwerken en veiligheid' : 'Teaching cloud, networking, and security'}
              </h2>
            </div>
            <a href={STATIC_ROUTES.tech[locale]} class="font-mono text-xs text-telemetry hover:underline">
              {isNl ? 'Meer over Onderwijs & IT →' : 'Explore Teaching & IT →'}
            </a>
          </div>

          <p class="text-base text-ink-secondary leading-relaxed max-w-3xl">
            {isNl
              ? 'Aan de IT Factory van Thomas More (Campus Geel) geef ik praktijkvakken in zowel het Nederlandstalige (1ITF) als Engelstalige (1ACS) traject. Ik geloof sterk in leren door te doen: studenten bouwen echte labs in AWS, Docker, Kubernetes, Cisco CCNA en PowerShell/Pester, en leren onderweg rustig en systematisch fouten opsporen.'
              : 'At Thomas More IT Factory (Geel Campus), I teach practical labs across both the Dutch (1ITF) and English (1ACS) tracks. I believe in learning by building: students work directly with AWS, Docker, Kubernetes, Cisco CCNA, and PowerShell/Pester, developing calm, structured troubleshooting habits.'}
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="editorial-card rounded-2xl p-6 space-y-4">
              <p class="font-mono text-xs uppercase tracking-wider text-kinetic">
                {isNl ? 'Boeken op papier' : 'Published handbooks'}
              </p>
              <div class="space-y-4 divide-y divide-border-subtle">
                {books.map((book) => (
                  <div class="pt-4 first:pt-0 space-y-1.5">
                    <div class="flex items-baseline justify-between gap-2">
                      <h3 class="font-display text-lg font-bold text-ink-primary">{book.title}</h3>
                      <span class="font-mono text-[11px] text-ink-secondary">{book.year}</span>
                    </div>
                    <p class="text-sm text-ink-secondary leading-relaxed">{book.description[locale]}</p>
                    <div class="flex items-center justify-between pt-1 font-mono text-xs">
                      <span class="text-kinetic">ISBN {book.isbn}</span>
                      <a href={book.buyUrl} target="_blank" rel="noopener noreferrer" class="text-telemetry hover:underline">
                        Bol.com ↗
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="editorial-card rounded-2xl overflow-hidden flex flex-col">
              <div class="aspect-[16/9] bg-surface-2 border-b border-border-subtle overflow-hidden">
                <EditorialVisuals kind="pcb" locale={locale} sizes="(max-width: 768px) 96vw, 440px" />
              </div>
              <div class="p-6 space-y-3 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  <p class="font-mono text-xs uppercase tracking-wider text-status">
                    {isNl ? 'Open source & eigen hardware' : 'Open source & custom hardware'}
                  </p>
                  <h3 class="font-display text-xl font-bold text-ink-primary">
                    {isNl ? 'Van honeypots tot zelf ontworpen printplaten' : 'From honeypots to custom circuit boards'}
                  </h3>
                  <p class="text-sm text-ink-secondary leading-relaxed">
                    {isNl
                      ? 'Op GitHub (@Slober3) deel ik lesmateriaal en experimenten zoals PotHead, ESP32-Public-Honeypot, BeeHive en mijn eigen Home+ Domotica printplaat. Daarnaast begeleid ik via RTC Antwerpen netwerkworkshops voor collega-leerkrachten.'
                      : 'On GitHub (@Slober3) I share lab tools and experiments including PotHead, ESP32-Public-Honeypot, BeeHive, and my Home+ custom PCB, alongside Cisco Train-the-Trainer workshops for RTC Antwerp.'}
                  </p>
                </div>
                <a href={STATIC_ROUTES.tech[locale]} class="font-mono text-xs font-semibold text-telemetry hover:underline pt-1">
                  {isNl ? 'Bekijk alle vakken, boeken & repositories →' : 'See courses, books & repositories →'}
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- Chapter 02: Personal Projects -->
        <section id="ch-02" class="space-y-8 scroll-reveal">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="space-y-2">
              <p class="font-mono text-xs text-status">02 · {isNl ? 'EIGEN PROJECTEN' : 'SIDE PROJECTS'}</p>
              <h2 class="font-display text-2xl sm:text-3xl font-bold text-ink-primary">
                {isNl ? 'Waar analytisch denken en hobby’s elkaar raken' : 'Where analytical thinking meets hands-on hobbies'}
              </h2>
            </div>
            <a href={STATIC_ROUTES.projects[locale]} class="font-mono text-xs text-status hover:underline">
              {isNl ? 'Alle projecten →' : 'All projects →'}
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {allProjects.map((entry) => {
              const baseProj = STATIC_ROUTES.projects[locale];
              return (
                <article class="editorial-card rounded-2xl overflow-hidden flex flex-col">
                  <a href={`${baseProj}${entry.data.slug}/`} class="group block aspect-[16/10] overflow-hidden border-b border-border-subtle bg-surface-2">
                    <EditorialVisuals
                      kind={entry.data.visualKind}
                      locale={locale}
                      sizes="(max-width: 768px) 96vw, 440px"
                      class="transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  </a>
                  <div class="p-6 flex-1 flex flex-col justify-between gap-4">
                    <div class="space-y-2.5">
                      <p class="font-mono text-[11px] uppercase tracking-wider text-kinetic">{entry.data.category}</p>
                      <h3 class="font-display text-2xl font-bold text-ink-primary">
                        <a href={`${baseProj}${entry.data.slug}/`} class="hover:text-kinetic transition-colors">
                          {entry.data.title}
                        </a>
                      </h3>
                      <p class="text-sm text-ink-secondary leading-relaxed">{entry.data.summary}</p>
                    </div>
                    <div class="pt-3 border-t border-border-subtle flex items-center justify-between gap-2 font-mono text-xs">
                      <span class="text-ink-secondary">{entry.data.stack.slice(0, 3).join(' · ')}</span>
                      <a href={`${baseProj}${entry.data.slug}/`} class="text-telemetry font-semibold hover:underline whitespace-nowrap">
                        {isNl ? 'Lees meer →' : 'Read more →'}
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <!-- Chapter 03: Motorcycles -->
        <section id="ch-03" class="space-y-6 scroll-reveal">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="space-y-2">
              <p class="font-mono text-xs text-kinetic">03 · @QUINTENMOTO · {isNl ? 'ONDERWEG' : 'ON THE ROAD'}</p>
              <h2 class="font-display text-2xl sm:text-3xl font-bold text-ink-primary">
                {isNl ? 'Bochtige binnendoorwegen op de Honda CB750 Hornet' : 'Chasing backroads on the Honda CB750 Hornet'}
              </h2>
            </div>
            <a href={STATIC_ROUTES.moto[locale]} class="font-mono text-xs text-kinetic hover:underline">
              {isNl ? 'Routes, Spa 2025 & uitrusting →' : 'Routes, Spa 2025 & gear →'}
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
            <a
              href={STATIC_ROUTES.moto[locale]}
              class="group md:col-span-8 block aspect-[16/10] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2"
            >
              <EditorialVisuals
                kind="hornet"
                locale={locale}
                sizes="(max-width: 768px) 96vw, 620px"
                class="transition-transform duration-500 group-hover:scale-[1.02]"
              />
            </a>
            <div class="md:col-span-4 flex flex-col gap-5">
              <a
                href={STATIC_ROUTES.moto[locale]}
                class="group block aspect-[16/10] md:aspect-[4/3] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2"
              >
                <EditorialVisuals
                  kind="spa"
                  locale={locale}
                  sizes="(max-width: 768px) 96vw, 300px"
                  class="transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </a>
              <div class="editorial-card rounded-2xl p-5 flex-1 flex flex-col justify-between gap-3">
                <p class="text-sm text-ink-secondary leading-relaxed">
                  {isNl
                    ? 'Intussen staat er zo’n 35.000 km op de teller van mijn CB750 Hornet. Ik mijd snelwegen zoveel mogelijk en zoek via Kurviger, Calimoto en Waze de mooiste lussen door de Ardennen en de Duitse Eifel.'
                    : 'With roughly 35,000 km on my CB750 Hornet, I skip straight highways whenever I can and map winding loops through the Ardennes and German Eifel using Kurviger, Calimoto, and Waze.'}
                </p>
                <a href={STATIC_ROUTES.moto[locale]} class="font-mono text-xs font-semibold text-kinetic hover:underline">
                  {isNl ? 'Bekijk ritten & GPX-kaart →' : 'See rides & route map →'}
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- Chapter 04: Photography, Notes & Personal Life -->
        <section id="ch-04" class="space-y-10 scroll-reveal">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="space-y-2">
              <p class="font-mono text-xs text-telemetry">04 · {isNl ? 'FOTOGRAFIE, NOTITIES & NU' : 'PHOTOGRAPHY, NOTES & NOW'}</p>
              <h2 class="font-display text-2xl sm:text-3xl font-bold text-ink-primary">
                {isNl ? 'Vertragen met een lens, schrijven en thuis met Stitch' : 'Slowing down with a lens, writing, and home with Stitch'}
              </h2>
            </div>
            <a href={STATIC_ROUTES.photography[locale]} class="font-mono text-xs text-telemetry hover:underline">
              {isNl ? 'Open fotogalerij →' : 'Open photo gallery →'}
            </a>
          </div>

          <!-- 3-Photo Editorial Triptych -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <a href={STATIC_ROUTES.photography[locale]} class="group block aspect-[3/2] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
              <EditorialVisuals kind="macro" locale={locale} sizes="(max-width: 640px) 96vw, 310px" class="transition-transform duration-500 group-hover:scale-[1.03]" />
            </a>
            <a href={STATIC_ROUTES.photography[locale]} class="group block aspect-[3/2] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
              <EditorialVisuals kind="travel" locale={locale} sizes="(max-width: 640px) 96vw, 310px" class="transition-transform duration-500 group-hover:scale-[1.03]" />
            </a>
            <a href={STATIC_ROUTES.photography[locale]} class="group block aspect-[3/2] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
              <EditorialVisuals kind="craft" locale={locale} sizes="(max-width: 640px) 96vw, 310px" class="transition-transform duration-500 group-hover:scale-[1.03]" />
            </a>
          </div>

          <!-- Latest 2 Notes -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {latestPosts.map((post) => (
              <article class="editorial-card rounded-2xl p-6 space-y-2.5">
                <p class="font-mono text-[11px] text-telemetry uppercase">{post.data.category} · {post.data.readingMinutes} min</p>
                <h3 class="font-display text-lg font-bold text-ink-primary">
                  <a href={`${STATIC_ROUTES.blog[locale]}${post.data.slug}/`} class="hover:text-kinetic transition-colors">
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-sm text-ink-secondary leading-relaxed">{post.data.description}</p>
              </article>
            ))}
          </div>

          <!-- Personal /now Snapshot paired with Stitch photo -->
          <div class="editorial-card rounded-2xl overflow-hidden grid grid-cols-1 md:grid-cols-12">
            <div class="md:col-span-5 aspect-[4/3] md:aspect-auto bg-surface-2">
              <EditorialVisuals kind="stitch" locale={locale} sizes="(max-width: 768px) 96vw, 380px" />
            </div>
            <div class="md:col-span-7 p-6 sm:p-8 flex flex-col justify-between gap-6">
              <div class="space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="font-mono text-xs uppercase tracking-wider text-kinetic">
                    {isNl ? 'Waar ik nu mee bezig ben' : 'What I’m into right now'}
                  </h3>
                  <div class="flex gap-3 font-mono text-xs">
                    <a href={STATIC_ROUTES.uses[locale]} class="text-telemetry hover:underline">/uses →</a>
                    <a href={STATIC_ROUTES.now[locale]} class="text-telemetry hover:underline">/now →</a>
                  </div>
                </div>
                <dl class="space-y-3.5">
                  {nowSection.items.slice(0, 4).map((item) => (
                    <div class="border-b border-border-subtle/70 pb-2.5 last:border-b-0 last:pb-0">
                      <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-secondary">{item.label[locale]}</dt>
                      <dd class="mt-0.5 text-sm text-ink-primary leading-relaxed">{item.value[locale]}</dd>
                    </div>
                  ))}
                </dl>
              </div>
              <a href={STATIC_ROUTES.about[locale]} class="font-mono text-xs font-semibold text-kinetic hover:underline">
                {isNl ? 'Lees meer over mij & download mijn CV →' : 'Read more about me & download my CV →'}
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const bindChapterRail = () => {
        const links = document.querySelectorAll('[data-chapter-link]');
        if (!links.length || !('IntersectionObserver' in window)) return;
        const sections = ['ch-01', 'ch-02', 'ch-03', 'ch-04']
          .map((id) => document.getElementById(id))
          .filter(Boolean);
        if (!sections.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const activeId = entry.target.id;
                links.forEach((l) => {
                  l.setAttribute('data-active', String(l.getAttribute('data-chapter-link') === activeId));
                });
              }
            });
          },
          { rootMargin: '-25% 0px -55% 0px' }
        );
        sections.forEach((sec) => observer.observe(sec));
      };

      document.addEventListener('astro:page-load', bindChapterRail);
    })();
  </script>
</EditorialLayout>
