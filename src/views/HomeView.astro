---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import EditorialVisuals from '@/components/EditorialVisuals.astro';
import YoutubeFacade from '@/components/YoutubeFacade.astro';
import { STATIC_ROUTES, type Locale } from '@/i18n/routes';
import { books, externalLinks } from '@/data/profile';
import { motoProfile, featuredVideos } from '@/data/moto';
import { nowSection } from '@/data/usesAndNow';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';

const siteBase = String(Astro.site ?? 'https://quintendesmyter.be').replace(/\/$/, '');
const allProjects = (await getCollection('projects', (e) => e.data.locale === locale))
  .sort((a, b) => a.data.order - b.data.order);
const allPosts = (await getCollection('blog', (e) => e.data.locale === locale))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));

const homeVideos = featuredVideos.slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: `${siteBase}${STATIC_ROUTES.home[locale]}`,
  mainEntity: {
    '@type': 'Person',
    '@id': `${siteBase}/#person`,
    name: 'Quinten Desmyter',
    url: `${siteBase}${STATIC_ROUTES.home[locale]}`,
    jobTitle: isNl ? 'Praktijklector Cloud, Netwerken & Cybersecurity' : 'Senior Lecturer Cloud, Networking & Cybersecurity',
    worksFor: {
      '@type': 'CollegeOrUniversity',
      name: 'Thomas More Hogeschool (IT Factory, Campus Geel)',
    },
    homeLocation: {
      '@type': 'Place',
      name: isNl ? 'Regio Lier / Kempen, België' : 'Lier / Campine Region, Belgium',
    },
    sameAs: ['https://github.com/Slober3', 'https://www.youtube.com/@QuintenMoto'],
  },
};
---

<EditorialLayout
  locale={locale}
  title={isNl
    ? 'Quinten Desmyter — Systemen, Precisie & Vrijheid'
    : 'Quinten Desmyter — Systems, Precision & Freedom'}
  description={isNl
    ? 'Persoonlijke website van Quinten Desmyter: praktijklector IT aan Thomas More (Campus Geel), auteur, motorrijder op een Honda CB750 Hornet (@QuintenMoto), fotograaf en maker.'
    : 'Personal website of Quinten Desmyter: IT lecturer at Thomas More (Geel Campus), author, Honda CB750 Hornet rider (@QuintenMoto), photographer, and maker.'}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-12">
    <!-- Band 1: Full-Width Zero-Gap Hero Bento with Real Quinten Photography -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
      <!-- Left: Intro + Quick Facts aligned cleanly to photo mosaic height -->
      <div class="lg:col-span-7 editorial-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between gap-6">
        <div class="space-y-4">
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-telemetry">
            {isNl
              ? 'QUINTEN DESMYTER · REGIO LIER / KEMPEN, BELGIË'
              : 'QUINTEN DESMYTER · LIER / CAMPINE REGION, BELGIUM'}
          </p>

          <h1 class="font-display text-3xl sm:text-4xl lg:text-[2.85rem] font-bold leading-[1.08] text-ink-primary">
            {isNl
              ? 'Hoi, ik ben Quinten. Ik geef les in IT, bouw eigen hardware en rijd het liefst binnendoor.'
              : 'Hi, I’m Quinten. I teach IT, design custom hardware, and chase twisty backroads.'}
          </h1>

          <p class="text-base sm:text-lg text-ink-secondary leading-relaxed">
            {isNl
              ? 'Overdag help ik studenten aan Thomas More (Campus Geel) op weg in cloud, netwerken en cybersecurity. Buiten het klaslokaal vind je mij op mijn gele Honda CB750 Hornet, met een camera in het bos of op reis, aan een eigen printplaat of bordspel, en thuis met mijn teckel Stitch.'
              : 'By day, I guide students at Thomas More (Geel Campus) through cloud, networking, and cybersecurity. Off the clock, you’ll find me on my yellow Honda CB750 Hornet, shooting macro and travel photos, building custom PCBs or tabletop games, and unwinding with my dachshund Stitch.'}
          </p>

          <div class="pt-1 flex flex-wrap items-center gap-3">
            <a
              href={STATIC_ROUTES.about[locale]}
              class="inline-flex items-center rounded-full bg-kinetic px-5 py-2.5 text-sm font-semibold text-canvas hover:bg-kinetic-hover transition-colors min-h-[44px]"
            >
              {isNl ? 'Over mij & CV' : 'About & Resume'}
            </a>
            <a
              href={STATIC_ROUTES.tech[locale]}
              class="inline-flex items-center rounded-full border border-border-subtle bg-surface-2 px-5 py-2.5 text-sm font-semibold text-ink-primary hover:border-telemetry transition-colors min-h-[44px]"
            >
              {isNl ? 'Onderwijs & IT' : 'Teaching & IT'}
            </a>
            <a
              href={STATIC_ROUTES.moto[locale]}
              class="inline-flex items-center rounded-full border border-border-subtle bg-surface-2 px-5 py-2.5 text-sm font-semibold text-ink-primary hover:border-kinetic transition-colors min-h-[44px]"
            >
              {isNl ? '@QuintenMoto video’s' : '@QuintenMoto videos'}
            </a>
          </div>
        </div>

        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-border-subtle pt-5">
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-wider text-ink-secondary">
              {isNl ? 'Onderwijs' : 'Teaching'}
            </dt>
            <dd class="mt-0.5 font-display text-sm font-semibold text-ink-primary">Thomas More · RTC</dd>
          </div>
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-wider text-ink-secondary">
              {isNl ? 'Boeken' : 'Books'}
            </dt>
            <dd class="mt-0.5 font-display text-sm font-semibold text-ink-primary">2× ISBN · IT & Python</dd>
          </div>
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-wider text-ink-secondary">
              {isNl ? 'Motor' : 'Bike'}
            </dt>
            <dd class="mt-0.5 font-display text-sm font-semibold text-ink-primary">CB750 Hornet</dd>
          </div>
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-wider text-ink-secondary">
              {isNl ? 'Thuisbasis' : 'Home base'}
            </dt>
            <dd class="mt-0.5 font-display text-sm font-semibold text-ink-primary">
              {isNl ? 'Kempen & Stitch' : 'Campine & Stitch'}
            </dd>
          </div>
        </dl>
      </div>

      <!-- Right: Real Photo Collage (Portrait + Yellow Hornet Action + Stitch) -->
      <div class="lg:col-span-5 grid grid-cols-12 gap-4">
        <a
          href={STATIC_ROUTES.about[locale]}
          class="group col-span-7 relative overflow-hidden rounded-2xl border border-border-subtle bg-surface-2 min-h-[300px] sm:min-h-[380px]"
        >
          <EditorialVisuals
            kind="portrait"
            locale={locale}
            eager={true}
            sizes="(max-width: 1024px) 58vw, 310px"
            class="transition-transform duration-500 group-hover:scale-[1.02]"
          />
          <span class="absolute bottom-3 left-3 rounded-lg bg-canvas/85 backdrop-blur px-2.5 py-1 font-mono text-[11px] text-ink-primary border border-border-subtle/80">
            Quinten Desmyter
          </span>
        </a>

        <div class="col-span-5 grid grid-rows-2 gap-4">
          <a
            href={STATIC_ROUTES.moto[locale]}
            class="group relative overflow-hidden rounded-2xl border border-border-subtle bg-surface-2 min-h-[140px]"
          >
            <EditorialVisuals
              kind="hornet"
              locale={locale}
              eager={true}
              sizes="(max-width: 1024px) 40vw, 220px"
              class="transition-transform duration-500 group-hover:scale-[1.04]"
            />
            <span class="absolute bottom-2.5 left-2.5 rounded-md bg-canvas/85 backdrop-blur px-2 py-0.5 font-mono text-[10px] text-kinetic border border-border-subtle/80">
              CB750 Hornet
            </span>
          </a>

          <a
            href={STATIC_ROUTES.about[locale]}
            class="group relative overflow-hidden rounded-2xl border border-border-subtle bg-surface-2 min-h-[140px]"
          >
            <EditorialVisuals
              kind="stitch"
              locale={locale}
              eager={true}
              sizes="(max-width: 1024px) 40vw, 220px"
              class="transition-transform duration-500 group-hover:scale-[1.04]"
            />
            <span class="absolute bottom-2.5 left-2.5 rounded-md bg-canvas/85 backdrop-blur px-2 py-0.5 font-mono text-[10px] text-ink-primary border border-border-subtle/80">
              Stitch
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- Band 2: Teaching, Published Books & Custom Hardware (3 Equal-Height Cards) -->
    <section class="space-y-5">
      <div class="flex flex-wrap items-end justify-between gap-3 border-b border-border-subtle pb-3">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-telemetry">
            {isNl ? 'ONDERWIJS, BOEKEN & HARDWARE' : 'TEACHING, BOOKS & HARDWARE'}
          </p>
          <h2 class="mt-0.5 font-display text-2xl sm:text-3xl font-bold text-ink-primary">
            {isNl ? 'Praktijkgericht IT-onderwijs en eigen builds' : 'Hands-on IT education and custom builds'}
          </h2>
        </div>
        <a href={STATIC_ROUTES.tech[locale]} class="font-mono text-xs font-semibold text-telemetry hover:underline">
          {isNl ? 'Alles over Onderwijs & IT →' : 'Full Teaching & IT overview →'}
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <!-- Card 1: Teaching -->
        <article class="editorial-card rounded-2xl p-6 flex flex-col justify-between gap-5">
          <div class="space-y-3">
            <p class="font-mono text-[11px] uppercase tracking-wider text-telemetry">Thomas More · Campus Geel</p>
            <h3 class="font-display text-xl font-bold text-ink-primary">
              {isNl ? 'Praktijklector 1ITF & 1ACS + RTC Antwerpen' : 'Lecturer 1ITF & 1ACS + RTC Antwerp'}
            </h3>
            <p class="text-sm text-ink-secondary leading-relaxed">
              {isNl
                ? 'Ik geef praktijkvakken in Cloud & Infrastructure (AWS, Docker, Kubernetes, Linux), Windows SysAdmin (Active Directory, PowerShell, Pester), Cisco CCNA 1 & 2 en IoT/Electronics. Daarnaast geef ik Cisco-workshops via RTC Antwerpen en ben ik coach bij studentenorganisatie SIN.'
                : 'I teach practical labs in Cloud & Infrastructure (AWS, Docker, Kubernetes, Linux), Windows SysAdmin (Active Directory, PowerShell, Pester), Cisco CCNA 1 & 2, and IoT/Electronics — plus Cisco workshops via RTC Antwerp and coaching at student organization SIN.'}
            </p>
          </div>
          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-border-subtle">
            {['AWS / Docker / K8s', 'Cisco CCNA', 'PowerShell + Pester', 'IoT / ESP32'].map((tag) => (
              <span class="rounded-md bg-surface-2 px-2.5 py-1 font-mono text-[11px] text-ink-primary">{tag}</span>
            ))}
          </div>
        </article>

        <!-- Card 2: Books -->
        <article class="editorial-card rounded-2xl p-6 flex flex-col justify-between gap-5">
          <div class="space-y-4">
            <p class="font-mono text-[11px] uppercase tracking-wider text-kinetic">
              {isNl ? 'Gepubliceerde handboeken' : 'Published handbooks'}
            </p>
            <div class="space-y-4 divide-y divide-border-subtle">
              {books.map((book) => (
                <div class="pt-3.5 first:pt-0 space-y-1">
                  <div class="flex items-baseline justify-between gap-2">
                    <h3 class="font-display text-base font-bold text-ink-primary">{book.title}</h3>
                    <span class="font-mono text-[11px] text-ink-secondary">{book.year}</span>
                  </div>
                  <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">{book.description[locale]}</p>
                  <div class="flex items-center justify-between pt-1 font-mono text-[11px]">
                    <span class="text-kinetic">ISBN {book.isbn}</span>
                    <a href={book.buyUrl} target="_blank" rel="noopener noreferrer" class="text-telemetry hover:underline">
                      Bol.com ↗
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="pt-3 border-t border-border-subtle flex items-center justify-between font-mono text-xs">
            <span class="text-ink-secondary">GitHub @Slober3</span>
            <a href={externalLinks.github} target="_blank" rel="noopener noreferrer" class="text-telemetry hover:underline">
              github.com/Slober3 ↗
            </a>
          </div>
        </article>

        <!-- Card 3: Real Custom PCB Photo + Hardware -->
        <article class="editorial-card rounded-2xl overflow-hidden flex flex-col">
          <div class="aspect-[16/9] bg-surface-2 border-b border-border-subtle overflow-hidden">
            <EditorialVisuals kind="pcb" locale={locale} sizes="(max-width: 1024px) 96vw, 400px" />
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between gap-4">
            <div class="space-y-2">
              <p class="font-mono text-[11px] uppercase tracking-wider text-status">
                {isNl ? 'Eigen elektronica & open source' : 'Custom electronics & open source'}
              </p>
              <h3 class="font-display text-xl font-bold text-ink-primary">
                {isNl ? 'ESP32, honeypots & eigen printplaten' : 'ESP32, honeypots & custom PCBs'}
              </h3>
              <p class="text-sm text-ink-secondary leading-relaxed">
                {isNl
                  ? 'Van eigen matzwarte printplaten (ESP32, 12V–5V omvormer, motordriver en Home+ Domotica) tot PotHead, BeeHive IoT en Pester-labs op GitHub.'
                  : 'From custom matte-black PCBs (ESP32, 12V–5V power stage, motor drivers, and Home+ Domotica) to PotHead, BeeHive IoT, and Pester labs on GitHub.'}
              </p>
            </div>
            <a href={STATIC_ROUTES.tech[locale]} class="font-mono text-xs font-semibold text-telemetry hover:underline">
              {isNl ? 'Bekijk repositories & hardware →' : 'View repositories & hardware →'}
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- Band 3: Direct Embedded @QuintenMoto YouTube Videos + Real Yellow Hornet Gallery -->
    <section class="space-y-5">
      <div class="flex flex-wrap items-end justify-between gap-3 border-b border-border-subtle pb-3">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-kinetic">
            @QUINTENMOTO · {motoProfile.bike}
          </p>
          <h2 class="mt-0.5 font-display text-2xl sm:text-3xl font-bold text-ink-primary">
            {isNl ? 'Direct kijken: ritten in de Eifel & Spa-Francorchamps' : 'Watch directly: rides in the Eifel & Spa-Francorchamps'}
          </h2>
        </div>
        <a href={STATIC_ROUTES.moto[locale]} class="font-mono text-xs font-semibold text-kinetic hover:underline">
          {isNl ? 'Alle 4 video’s, 6 Spa-testritten & GPX-kaart →' : 'All 4 videos, 6 Spa test rides & GPX map →'}
        </a>
      </div>

      <!-- 2 Directly Embedded Playable YouTube Videos -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        {homeVideos.map((v) => (
          <YoutubeFacade
            locale={locale}
            videoId={v.youtubeId}
            duration={v.duration}
            title={v.title[locale]}
            meta={v.meta}
            notes={v.notes[locale]}
          />
        ))}
      </div>

      <!-- 3-Photo Real Yellow Hornet Strip -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <a href={STATIC_ROUTES.moto[locale]} class="group relative aspect-[3/2] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
          <EditorialVisuals kind="hornet" locale={locale} sizes="(max-width: 640px) 96vw, 400px" class="transition-transform duration-500 group-hover:scale-[1.03]" />
        </a>
        <a href={STATIC_ROUTES.moto[locale]} class="group relative aspect-[3/2] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
          <EditorialVisuals kind="hornetSquare" locale={locale} sizes="(max-width: 640px) 96vw, 400px" class="transition-transform duration-500 group-hover:scale-[1.03]" />
        </a>
        <a href={STATIC_ROUTES.moto[locale]} class="group relative aspect-[3/2] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
          <EditorialVisuals kind="motoSunset" locale={locale} sizes="(max-width: 640px) 96vw, 400px" class="transition-transform duration-500 group-hover:scale-[1.03]" />
        </a>
      </div>
    </section>

    <!-- Band 4: Real Photography Strip + 4 Equal Project Cards -->
    <section class="space-y-5">
      <div class="flex flex-wrap items-end justify-between gap-3 border-b border-border-subtle pb-3">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-telemetry">
            {isNl ? 'DOOR DE LENS & EIGEN PROJECTEN' : 'THROUGH THE LENS & PROJECTS'}
          </p>
          <h2 class="mt-0.5 font-display text-2xl sm:text-3xl font-bold text-ink-primary">
            {isNl ? 'Fotografie en projecten waar ik aan sleutel' : 'Photography and projects I build on the side'}
          </h2>
        </div>
        <div class="flex gap-4 font-mono text-xs font-semibold">
          <a href={STATIC_ROUTES.photography[locale]} class="text-telemetry hover:underline">
            {isNl ? 'Fotogalerij (11 foto’s) →' : 'Photo gallery (11 photos) →'}
          </a>
          <a href={STATIC_ROUTES.projects[locale]} class="text-status hover:underline">
            {isNl ? 'Alle projecten →' : 'All projects →'}
          </a>
        </div>
      </div>

      <!-- 4-Photo Real DSLR Strip -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <a href={STATIC_ROUTES.photography[locale]} class="group relative aspect-[3/2] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
          <EditorialVisuals kind="macro" locale={locale} sizes="(max-width: 1024px) 48vw, 300px" class="transition-transform duration-500 group-hover:scale-[1.04]" />
          <span class="absolute bottom-2.5 left-2.5 rounded-md bg-canvas/85 backdrop-blur px-2 py-0.5 font-mono text-[10px] text-ink-primary">Macro</span>
        </a>
        <a href={STATIC_ROUTES.photography[locale]} class="group relative aspect-[3/2] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
          <EditorialVisuals kind="macroMushroom" locale={locale} sizes="(max-width: 1024px) 48vw, 300px" class="transition-transform duration-500 group-hover:scale-[1.04]" />
          <span class="absolute bottom-2.5 left-2.5 rounded-md bg-canvas/85 backdrop-blur px-2 py-0.5 font-mono text-[10px] text-ink-primary">
            {isNl ? 'Herfstbos' : 'Woodland'}
          </span>
        </a>
        <a href={STATIC_ROUTES.photography[locale]} class="group relative aspect-[3/2] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
          <EditorialVisuals kind="london" locale={locale} sizes="(max-width: 1024px) 48vw, 300px" class="transition-transform duration-500 group-hover:scale-[1.04]" />
          <span class="absolute bottom-2.5 left-2.5 rounded-md bg-canvas/85 backdrop-blur px-2 py-0.5 font-mono text-[10px] text-ink-primary">
            {isNl ? 'Londen' : 'London'}
          </span>
        </a>
        <a href={STATIC_ROUTES.photography[locale]} class="group relative aspect-[3/2] overflow-hidden rounded-2xl border border-border-subtle bg-surface-2">
          <EditorialVisuals kind="aachen" locale={locale} sizes="(max-width: 1024px) 48vw, 300px" class="transition-transform duration-500 group-hover:scale-[1.04]" />
          <span class="absolute bottom-2.5 left-2.5 rounded-md bg-canvas/85 backdrop-blur px-2 py-0.5 font-mono text-[10px] text-ink-primary">
            {isNl ? 'Aken' : 'Aachen'}
          </span>
        </a>
      </div>

      <!-- 4 Compact Equal-Height Project Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {allProjects.map((entry) => {
          const href = `${STATIC_ROUTES.projects[locale]}${entry.data.slug}/`;
          return (
            <article class="editorial-card rounded-2xl p-5 flex flex-col justify-between gap-4">
              <div class="space-y-2">
                <p class="font-mono text-[10px] uppercase tracking-wider text-kinetic">{entry.data.category}</p>
                <h3 class="font-display text-lg font-bold text-ink-primary leading-snug">
                  <a href={href} class="hover:text-kinetic transition-colors">{entry.data.title}</a>
                </h3>
                <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">{entry.data.summary}</p>
              </div>
              <div class="pt-3 border-t border-border-subtle flex items-center justify-between gap-2 font-mono text-[11px]">
                <span class="text-status truncate">{entry.data.status}</span>
                <a href={href} class="text-telemetry font-semibold hover:underline whitespace-nowrap">
                  {isNl ? 'Open →' : 'Open →'}
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Band 5: Personal /now + Stitch alongside 2x2 Blog Notes (Balanced 12-Col Row) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
      <!-- Left: Personal Life & Stitch -->
      <div class="lg:col-span-5 editorial-card rounded-2xl overflow-hidden flex flex-col">
        <div class="grid grid-cols-2 gap-0.5 bg-border-subtle border-b border-border-subtle">
          <div class="aspect-[4/3] bg-surface-2 overflow-hidden">
            <EditorialVisuals kind="stitch" locale={locale} sizes="(max-width: 1024px) 48vw, 250px" />
          </div>
          <div class="aspect-[4/3] bg-surface-2 overflow-hidden">
            <EditorialVisuals kind="stitchDuo" locale={locale} sizes="(max-width: 1024px) 48vw, 250px" />
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between gap-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2">
              <p class="font-mono text-xs uppercase tracking-wider text-kinetic">
                {isNl ? 'Nu & buiten de lesuren' : 'Now & off the clock'}
              </p>
              <div class="flex gap-3 font-mono text-xs">
                <a href={STATIC_ROUTES.uses[locale]} class="text-telemetry hover:underline">/uses</a>
                <a href={STATIC_ROUTES.now[locale]} class="text-telemetry hover:underline">/now</a>
              </div>
            </div>
            <dl class="space-y-2.5">
              {nowSection.items.slice(0, 4).map((item) => (
                <div class="border-b border-border-subtle/70 pb-2 last:border-b-0 last:pb-0">
                  <dt class="font-mono text-[10px] uppercase tracking-wider text-ink-secondary">{item.label[locale]}</dt>
                  <dd class="mt-0.5 text-xs sm:text-sm text-ink-primary leading-relaxed">{item.value[locale]}</dd>
                </div>
              ))}
            </dl>
          </div>
          <a href={STATIC_ROUTES.about[locale]} class="font-mono text-xs font-semibold text-kinetic hover:underline">
            {isNl ? 'Meer over mij, hobby’s & CV →' : 'More about me, hobbies & CV →'}
          </a>
        </div>
      </div>

      <!-- Right: All 4 Blog Articles in a Tight 2x2 Grid -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        <div class="flex items-center justify-between gap-2 border-b border-border-subtle pb-3">
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-telemetry">
              {isNl ? 'NOTITIES & ARTIKELEN' : 'NOTES & ARTICLES'}
            </p>
            <h2 class="mt-0.5 font-display text-xl sm:text-2xl font-bold text-ink-primary">
              {isNl ? 'Uit de lespraktijk en het lab' : 'From the classroom and lab'}
            </h2>
          </div>
          <a href={STATIC_ROUTES.blog[locale]} class="font-mono text-xs font-semibold text-telemetry hover:underline">
            {isNl ? 'Alle notities →' : 'All notes →'}
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 flex-1">
          {allPosts.map((post) => (
            <article class="editorial-card rounded-2xl p-5 flex flex-col justify-between gap-3">
              <div class="space-y-2">
                <p class="font-mono text-[10px] text-telemetry uppercase">
                  {post.data.category} · {post.data.readingMinutes} min
                </p>
                <h3 class="font-display text-base font-bold text-ink-primary leading-snug">
                  <a href={`${STATIC_ROUTES.blog[locale]}${post.data.slug}/`} class="hover:text-kinetic transition-colors">
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-xs text-ink-secondary leading-relaxed">{post.data.description}</p>
              </div>
              <a
                href={`${STATIC_ROUTES.blog[locale]}${post.data.slug}/`}
                class="font-mono text-[11px] font-semibold text-telemetry hover:underline pt-2 border-t border-border-subtle/70"
              >
                {isNl ? 'Lees artikel →' : 'Read article →'}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</EditorialLayout>
