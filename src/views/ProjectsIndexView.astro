---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import EditorialVisuals from '@/components/EditorialVisuals.astro';
import { STATIC_ROUTES, type Locale } from '@/i18n/routes';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';

const entries = (await getCollection('projects', (e) => e.data.locale === locale))
  .sort((a, b) => a.data.order - b.data.order);
---

<EditorialLayout
  locale={locale}
  title={isNl ? 'Projecten — Quinten Desmyter' : 'Projects — Quinten Desmyter'}
  description={isNl
    ? 'Eigen projecten van Quinten Desmyter: bordspel Weavers Fate, schietsport & beeldherkenning, IoT-honeypots en eigen printplaatontwerp.'
    : 'Personal projects by Quinten Desmyter: Weavers Fate dice game, sport shooting & computer vision, IoT honeypots, and custom PCB design.'}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    <header class="space-y-3 border-b border-border-subtle pb-8">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-telemetry">
        {isNl ? 'EIGEN PROJECTEN' : 'PERSONAL PROJECTS'}
      </p>
      <h1 class="font-display text-3xl sm:text-5xl font-bold leading-[1.08] text-ink-primary">
        {isNl ? 'Spelontwerp, software en eigen hardware.' : 'Game design, software, and custom hardware.'}
      </h1>
      <p class="text-base sm:text-lg text-ink-secondary max-w-3xl leading-relaxed">
        {isNl
          ? 'Een selectie van projecten waar ik in mijn vrije tijd en voor mijn lessen aan werk — van een strategisch blufspel met dobbelstenen tot beeldherkenning op schietschijven en zelf ontworpen printplaten.'
          : 'A selection of projects I build across teaching and spare time — from a strategic tabletop dice game to target-scoring vision experiments and custom circuit boards.'}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {entries.map((proj) => {
        const href = `${STATIC_ROUTES.projects[locale]}${proj.data.slug}/`;
        return (
          <article class="editorial-card rounded-2xl overflow-hidden flex flex-col">
            <a href={href} class="group block aspect-[16/9] overflow-hidden border-b border-border-subtle bg-surface-2">
              <EditorialVisuals
                kind={proj.data.visualKind}
                locale={locale}
                sizes="(max-width: 768px) 96vw, 540px"
                class="transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </a>
            <div class="p-6 flex-1 flex flex-col justify-between gap-4">
              <div class="space-y-2">
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-[11px]">
                  <span class="uppercase tracking-wider text-kinetic">{proj.data.category}</span>
                  <span class="text-status">{proj.data.status}</span>
                </div>
                <h2 class="font-display text-2xl font-bold text-ink-primary">
                  <a href={href} class="hover:text-kinetic transition-colors">{proj.data.title}</a>
                </h2>
                <p class="text-sm text-ink-secondary leading-relaxed">{proj.data.summary}</p>
              </div>
              <div class="pt-3 border-t border-border-subtle flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap gap-1.5">
                  {proj.data.stack.slice(0, 3).map((tag) => (
                    <span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-ink-primary">
                      {tag}
                    </span>
                  ))}
                </div>
                <a href={href} class="font-mono text-xs font-semibold text-telemetry hover:underline">
                  {isNl ? 'Lees meer →' : 'Read more →'}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</EditorialLayout>
