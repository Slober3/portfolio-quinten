---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import EditorialVisuals from '@/components/EditorialVisuals.astro';
import { STATIC_ROUTES, type Locale } from '@/i18n/routes';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';

const entries = (await getCollection('projects', (e) => e.data.locale === locale))
  .sort((a, b) => a.data.order - b.data.order);
---

<EditorialLayout
  locale={locale}
  title={isNl ? 'Projectdossiers — Quinten Desmyter' : 'Projects — Quinten Desmyter'}
  description={isNl
    ? 'Diepgaande projectdossiers: Weavers Fate, Schietsport & Computer Vision R&D, IoT Honeypots en eigen PCB-ontwerp.'
    : 'In-depth project dossiers: Weavers Fate, Sport Shooting & Computer Vision R&D, IoT Honeypots, and custom PCB engineering.'}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12">
    <header class="space-y-4 border-b border-border-subtle pb-10">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-telemetry">
        {isNl ? 'PROJECTDOSSIERS' : 'PROJECT DOSSIERS'}
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold leading-[1.1] text-ink-primary">
        {isNl ? 'Speltheorie, Security Deceptie & Hardware' : 'Game Math, Security Deception & Hardware'}
      </h1>
      <p class="text-lg text-ink-secondary max-w-3xl">
        {isNl
          ? 'Projecten waarin analytisch systeemdenken samensmelt met tastbaar ontwerp — van dobbelsteen-economie en OpenCV-onderzoek tot microcontrollers.'
          : 'Projects where analytical systems engineering meets physical design — from dice economies and OpenCV R&D to microcontrollers.'}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {entries.map((proj) => {
        const href = `${STATIC_ROUTES.projects[locale]}${proj.data.slug}/`;
        return (
          <article class="editorial-card rounded-2xl overflow-hidden flex flex-col">
            <a href={href} class="block aspect-[21/10] border-b border-border-subtle bg-surface-2">
              <EditorialVisuals kind={proj.data.visualKind} />
            </a>
            <div class="p-6 flex-1 flex flex-col justify-between gap-4">
              <div class="space-y-2.5">
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-[11px]">
                  <span class="uppercase tracking-wider text-kinetic">{proj.data.category}</span>
                  <span class="text-status">{proj.data.status}</span>
                </div>
                <h2 class="font-display text-2xl font-bold text-ink-primary">
                  <a href={href} class="hover:text-kinetic transition-colors">{proj.data.title}</a>
                </h2>
                <p class="text-sm text-ink-secondary leading-relaxed">{proj.data.summary}</p>
              </div>
              <div class="pt-3 border-t border-border-subtle flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap gap-1.5">
                  {proj.data.stack.slice(0, 3).map((tag) => (
                    <span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-ink-primary">
                      {tag}
                    </span>
                  ))}
                </div>
                <a href={href} class="font-mono text-xs font-semibold text-telemetry hover:underline">
                  {isNl ? 'Open dossier →' : 'Open dossier →'}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</EditorialLayout>
