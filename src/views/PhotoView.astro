---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import PhotoGallery from '@/components/PhotoGallery.astro';
import type { Locale } from '@/i18n/routes';
import { externalLinks } from '@/data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';
const showreelUrl = import.meta.env.PUBLIC_SHOWREEL_URL || '';
---

<EditorialLayout
  locale={locale}
  title={isNl ? 'Fotografie — Quinten Desmyter' : 'Photography — Quinten Desmyter'}
  description={isNl
    ? 'Fotogalerij van Quinten Desmyter: natuur en macrofotografie in België, motorritten door de Ardennen en Eifel, reisbeelden en eigen werkplaatsprojecten.'
    : 'Photography gallery by Quinten Desmyter: Belgian nature and macro studies, motorcycle roads in the Ardennes and Eifel, travel light, and workshop builds.'}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-14">
    <header class="space-y-5 border-b border-border-subtle pb-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-telemetry">
          {isNl ? 'FOTOGRAFIE · DOOR DE LENS' : 'PHOTOGRAPHY · THROUGH THE LENS'}
        </p>
        {externalLinks.shutterstock && (
          <a href={externalLinks.shutterstock} target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-kinetic hover:underline">
            Shutterstock ↗
          </a>
        )}
      </div>

      <h1 class="font-display text-4xl sm:text-5xl font-bold leading-[1.1] text-ink-primary max-w-4xl">
        {isNl
          ? 'Van stil macrolicht in het bos tot avondzon op de Eifel.'
          : 'From quiet woodland macro light to golden hour in the Eifel.'}
      </h1>
      <p class="text-lg text-ink-secondary max-w-3xl leading-relaxed">
        {isNl
          ? 'Een camera dwingt je om trager te kijken. Hier verzamel ik beelden uit vier werelden waar ik graag tijd doorbreng: kleine natuurdetails in de Kempen, onderweg met de motor, reizen langs Europese kusten en steden, en eigen werk in het lab.'
          : 'Carrying a camera slows you down in the best way. Here is a selection from four places I love spending time: tiny nature details in Belgian woods, backroad rides, European coastal and city trips, and close-ups from the maker bench.'}
      </p>
    </header>

    <PhotoGallery locale={locale} />

    {showreelUrl && (
      <section class="editorial-card rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <p class="font-mono text-xs uppercase tracking-wider text-kinetic">
            {isNl ? 'SHOWREEL' : 'SHOWREEL'}
          </p>
          <h2 class="font-display text-2xl font-bold text-ink-primary">
            {isNl ? 'Korte impressie in beeld en geluid' : 'Short motion reel'}
          </h2>
          <p class="text-sm text-ink-secondary">
            {isNl
              ? 'Een korte compilatie van motorritten en reissfeer in 4K.'
              : 'A short compilation of motorcycle rides and travel atmosphere in 4K.'}
          </p>
        </div>

        <div class="w-full md:w-96 aspect-video rounded-xl overflow-hidden border border-border-subtle bg-surface-2">
          <video controls preload="metadata" class="w-full h-full object-cover">
            <source src={showreelUrl} type="video/mp4" />
          </video>
        </div>
      </section>
    )}
  </div>
</EditorialLayout>
