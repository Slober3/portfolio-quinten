---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import PhotoGallery from '@/components/PhotoGallery.astro';
import type { Locale } from '@/i18n/routes';
import { externalLinks } from '@/data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isNl = locale === 'nl';
const showreelUrl = import.meta.env.PUBLIC_SHOWREEL_URL || '';
---

<EditorialLayout
  locale={locale}
  title={isNl ? 'Fotografie — Quinten Desmyter' : 'Photography — Quinten Desmyter'}
  description={isNl
    ? 'Eigen fotogalerij van Quinten Desmyter: natuur en macrofotografie in België, gele Honda CB750 Hornet onderweg, reizen naar Londen, Dubrovnik & Aken, en eigen elektronica.'
    : 'Original photography by Quinten Desmyter: Belgian nature and macro studies, yellow Honda CB750 Hornet on the road, travels to London, Dubrovnik & Aachen, and custom electronics.'}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    <header class="space-y-4 border-b border-border-subtle pb-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-telemetry">
          {isNl ? 'FOTOGRAFIE · EIGEN BEELDEN' : 'PHOTOGRAPHY · ORIGINAL SHOTS'}
        </p>
        {externalLinks.shutterstock && (
          <a href={externalLinks.shutterstock} target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-kinetic hover:underline">
            Shutterstock ↗
          </a>
        )}
      </div>

      <h1 class="font-display text-3xl sm:text-5xl font-bold leading-[1.08] text-ink-primary max-w-4xl">
        {isNl
          ? 'Macro in het bos, onderweg op de Hornet en reizen door Europa.'
          : 'Woodland macro, riding the Hornet, and travels across Europe.'}
      </h1>
      <p class="text-base sm:text-lg text-ink-secondary max-w-3xl leading-relaxed">
        {isNl
          ? 'Een camera dwingt je om even stil te staan. Hier verzamel ik een selectie van mijn eigen foto’s uit vier werelden: macrodetails in de natuur, onderweg met de motor, reizen naar onder meer Londen, Dubrovnik en Aken, en eigen elektronicaprojecten op de werkbank.'
          : 'Carrying a camera slows you down in the best way. Here is a curated selection of my own photographs across four worlds: nature macro, motorcycle rides, trips to London, Dubrovnik, and Aachen, and custom electronics on the bench.'}
      </p>
    </header>

    <PhotoGallery locale={locale} />

    {showreelUrl && (
      <section class="editorial-card rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <p class="font-mono text-xs uppercase tracking-wider text-kinetic">SHOWREEL</p>
          <h2 class="font-display text-2xl font-bold text-ink-primary">
            {isNl ? 'Korte impressie in beeld en geluid' : 'Short motion reel'}
          </h2>
          <p class="text-sm text-ink-secondary">
            {isNl
              ? 'Een korte compilatie van motorritten en reissfeer in 4K.'
              : 'A short compilation of motorcycle rides and travel atmosphere in 4K.'}
          </p>
        </div>

        <div class="w-full md:w-96 aspect-video rounded-xl overflow-hidden border border-border-subtle bg-surface-2">
          <video controls preload="metadata" class="w-full h-full object-cover">
            <source src={showreelUrl} type="video/mp4" />
          </video>
        </div>
      </section>
    )}
  </div>
</EditorialLayout>
